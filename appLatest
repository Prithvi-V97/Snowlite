                edited_data = pd.DataFrame(grid_resp["data"])
            else:
                # fallback to st.data_editor; configure columns editable based on edit mode (safe API)
                column_config = {}
                if not st.session_state[edit_key]:
                    # edit mode is disabled → mark all columns readonly (disabled=True)
                    for c in main_df.columns:
                        column_config[c] = st.column_config.Column(disabled=True)
                    edited_data = st.data_editor(
                        main_df,
                        use_container_width=True,
                        num_rows="dynamic",
                        column_config=column_config,
                        key=f"data_editor_main_{table_key}"
                    )
                else:
                    # edit mode is enabled → data_editor is editable by default (no editable flag)
                    edited_data = st.data_editor(
                        main_df,
                        use_container_width=True,
                        num_rows="dynamic",
                        key=f"data_editor_main_{table_key}"
                    )

            # Button: Send Edits to Approval (existing logic) — uses get_row_key for composite keys
            if st.button("Send Edits to Approval", key=f"send_edits_{table_key}"):
                try:
                    orig = main_df.copy()
                    new = edited_data.copy()

                    # Build index maps by composite or single key using get_row_key
                    orig_index = {}
                    new_index = {}

                    if not orig.empty:
                        for _, r in orig.iterrows():
                            k = get_row_key(r, key_cols)
                            orig_index[k] = r
                    if not new.empty:
                        for _, r in new.iterrows():
                            k = get_row_key(r, key_cols)
                            new_index[k] = r

                    # Helper to detect empty key (tuple or string)
                    def is_empty_key(k):
                        if isinstance(k, tuple):
                            return all((str(p) == "" or str(p).lower() == "nan") for p in k)
                        if isinstance(k, str):
                            return (k == "" or k.lower() == "nan")
                        return False

                    # Initial classification
                    deleted_keys = [k for k in orig_index.keys() if k not in new_index.keys()]
                    inserted_keys = [k for k in new_index.keys() if (k not in orig_index.keys() or is_empty_key(k))]
                    updated_keys = []
                    for k in orig_index.keys():
                        if k in new_index:
                            o = orig_index[k]
                            n = new_index[k]
                            changed = False
                            for c in orig.columns:
                                o_val = o.get(c)
                                n_val = n.get(c)
                                if isinstance(o_val, str):
                                    o_val = normalize_string(o_val)
                                if isinstance(n_val, str):
                                    n_val = normalize_string(n_val)
                                try:
                                    if pd.isna(o_val):
                                        o_val = None
                                except Exception:
                                    pass
                                try:
                                    if pd.isna(n_val):
                                        n_val = None
                                except Exception:
                                    pass
                                if (o_val is None and n_val is None) or (o_val == n_val):
                                    continue
                                changed = True
                                break
                            if changed:
                                updated_keys.append(k)

                    # --- Pair deleted + inserted keys as updates when rows match on non-key columns ---
                    paired_updates = []  # list of tuples (old_key, new_key)
                    if deleted_keys and inserted_keys:
                        # prepare list of non-key columns to compare
                        non_key_cols = [c for c in orig.columns if (not (isinstance(key_cols, (list, tuple)) and c in key_cols) and not (isinstance(key_cols, str) and c == key_cols))]
                        if not non_key_cols:
                            if isinstance(key_cols, (list, tuple)):
                                non_key_cols = [c for c in required_cols if c not in key_cols]
                            else:
                                non_key_cols = [c for c in required_cols if c != key_cols]

                        def non_key_signature(row):
                            sig = []
                            for col in non_key_cols:
                                v = None
                                try:
                                    v = row.get(col)
                                except Exception:
                                    for colname in row.index:
                                        if str(colname).lower() == str(col).lower():
                                            v = row[colname]
                                            break
                                if isinstance(v, str):
                                    v = normalize_string(v)
                                else:
                                    try:
                                        if pd.isna(v):
                                            v = None
                                    except Exception:
                                        pass
                                sig.append('' if v is None else str(v))
                            return tuple(sig)

                        deleted_sigs = {dk: non_key_signature(orig_index[dk]) for dk in deleted_keys}
                        inserted_sigs = {ik: non_key_signature(new_index[ik]) for ik in inserted_keys}

                        used_inserts = set()
                        used_deletes = set()
                        for dk, dsig in deleted_sigs.items():
                            for ik, isig in inserted_sigs.items():
                                if ik in used_inserts:
                                    continue
                                if dsig == isig:
                                    paired_updates.append((dk, ik))
                                    used_deletes.add(dk)
                                    used_inserts.add(ik)
                                    break

                        deleted_keys = [k for k in deleted_keys if k not in used_deletes]
                        inserted_keys = [k for k in inserted_keys if k not in used_inserts]

                    processed = 0
                    errors = []

                    # Process paired updates first
                    for old_k, new_k in paired_updates:
                        try:
                            orig_row = orig_index.get(old_k)
                            new_row = new_index.get(new_k)
                            # Insert the new representation into TEMP
                            vals_list = []
                            for col in required_cols:
                                v = new_row.get(col) if new_row is not None else None
                                if isinstance(v, str):
                                    v = normalize_string(v)
                                try:
                                    if pd.isna(v):
                                        v = None
                                except Exception:
                                    pass
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    vals_list.append("'" + str(v).replace("'", "''") + "'")
                            cols_sql = ", ".join(required_cols)
                            vals_sql = ", ".join(vals_list)
                            insert_temp_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_temp_sql).collect()
                            # Log as UPDATE with old and new dicts
                            old_d = {}
                            new_d = {}
                            for col in required_cols:
                                o = orig_row.get(col) if orig_row is not None else None
                                n = new_row.get(col) if new_row is not None else None
                                if isinstance(o, str):
                                    o = normalize_string(o)
                                if isinstance(n, str):
                                    n = normalize_string(n)
                                try:
                                    if pd.isna(o):
                                        o = None
                                except Exception:
                                    pass
                                try:
                                    if pd.isna(n):
                                        n = None
                                except Exception:
                                    pass
                                old_d[col] = o
                                new_d[col] = n
                            log_change(main_table, "UPDATE", old_d, new_d)
                            processed += 1
                        except Exception as e:
                            errors.append("Error processing paired update old_key=" + str(old_k) + " new_key=" + str(new_k) + ": " + str(e))

                    # Process unchanged-key updates
                    for k in updated_keys:
                        try:
                            orig_row = orig_index.get(k)
                            new_row = new_index.get(k)
                            vals_list = []
                            for col in required_cols:
                                v = new_row.get(col) if new_row is not None else None
                                if isinstance(v, str):
                                    v = normalize_string(v)
                                try:
                                    if pd.isna(v):
                                        v = None
                                except Exception:
                                    pass
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    vals_list.append("'" + str(v).replace("'", "''") + "'")
                            cols_sql = ", ".join(required_cols)
                            vals_sql = ", ".join(vals_list)
                            insert_temp_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_temp_sql).collect()
                            # build dicts and log UPDATE
                            old_d = {}
                            new_d = {}
                            for col in required_cols:
                                o = orig_row.get(col) if orig_row is not None else None
                                n = new_row.get(col) if new_row is not None else None
                                if isinstance(o, str):
                                    o = normalize_string(o)
                                if isinstance(n, str):
                                    n = normalize_string(n)
                                try:
                                    if pd.isna(o):
                                        o = None
                                except Exception:
                                    pass
                                try:
                                    if pd.isna(n):
                                        n = None
                                except Exception:
                                    pass
                                old_d[col] = o
                                new_d[col] = n
                            log_change(main_table, "UPDATE", old_d, new_d)
                            processed += 1
                        except Exception as e:
                            errors.append("Error processing update key=" + str(k) + ": " + str(e))

                    # Process pure inserts
                    for ik in inserted_keys:
                        try:
                            new_row = new_index.get(ik)
                            vals_list = []
                            for col in required_cols:
                                v = new_row.get(col) if new_row is not None else None
                                if isinstance(v, str):
                                    v = normalize_string(v)
                                try:
                                    if pd.isna(v):
                                        v = None
                                except Exception:
                                    pass
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    vals_list.append("'" + str(v).replace("'", "''") + "'")
                            cols_sql = ", ".join(required_cols)
                            vals_sql = ", ".join(vals_list)
                            insert_temp_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_temp_sql).collect()
                            nv = new_row.to_dict() if hasattr(new_row, "to_dict") else new_row
                            log_change(main_table, "INSERT", None, nv)
                            processed += 1
                        except Exception as e:
                            errors.append("Error processing insert key=" + str(ik) + ": " + str(e))

                    # Process pure deletes
                    for dk in deleted_keys:
                        try:
                            old_row = orig_index.get(dk)
                            vals_list = []
                            for col in required_cols:
                                v = old_row.get(col) if old_row is not None else None
                                if isinstance(v, str):
                                    v = normalize_string(v)
                                try:
                                    if pd.isna(v):
                                        v = None
                                except Exception:
                                    pass
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    vals_list.append("'" + str(v).replace("'", "''") + "'")
                            cols_sql = ", ".join(required_cols)
                            vals_sql = ", ".join(vals_list)
                            insert_temp_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_temp_sql).collect()
                            log_change(main_table, "DELETE", old_row.to_dict() if hasattr(old_row, "to_dict") else old_row, None)
                            processed += 1
                        except Exception as e:
                            errors.append("Error processing delete key=" + str(dk) + ": " + str(e))

                    st.success("Sent edits to TEMP and logged for approval. Processed: " + str(processed))
                    if errors:
                        for er in errors:
                            st.warning(er)

                except Exception as e:
                    st.error("Error processing edits for approval: " + str(e))

        # -------------------------
        # Upload / Manual Insert / Temp CRUD
        # -------------------------
        st.markdown("---")
        st.markdown("### Upload Excel or CSV (Inserts into TEMP Table)")
        uploaded_file = st.file_uploader("Upload for " + table_key, type=["xlsx", "csv"])
        if uploaded_file:
            excel_df = read_uploaded_file(uploaded_file)
            if excel_df is not None:
                excel_df.columns = [col.strip().upper() for col in excel_df.columns]
                required_cols_upper = [col.upper() for col in required_cols]
                st.dataframe(excel_df.head())
                if all(col in excel_df.columns for col in required_cols_upper):
                    if st.button("Upload to TEMP for " + table_key):
                        inserted = 0
                        for _, row in excel_df.iterrows():
                            cols_sql = ", ".join(required_cols_upper)
                            vals_list = []
                            for col in required_cols_upper:
                                v = row.get(col, "")
                                if isinstance(v, str):
                                    v = normalize_string(v)
                                try:
                                    if pd.isna(v):
                                        v = None
                                except Exception:
                                    pass
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    sval = str(v).replace("'", "''")
                                    vals_list.append("'" + sval + "'")
                            vals_sql = ", ".join(vals_list)
                            insert_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_sql).collect()
                            row_dict = {c: clean_for_json(normalize_string(row.get(c)) if isinstance(row.get(c), str) else row.get(c)) for c in required_cols_upper}
                            log_change(main_table, "INSERT", None, row_dict)
                            inserted += 1
                        st.success(str(inserted) + " rows uploaded to TEMP table and logged.")
                else:
                    st.error("Missing columns. Required: " + str(required_cols))

        st.subheader("Manual Insert into TEMP Table")
        with st.form("insert_form_" + table_key):
            inputs = {col: st.text_input(col) for col in required_cols}
            submit = st.form_submit_button("Insert Record")
            if submit:
                cols_sql = ", ".join(inputs.keys())
                cleaned_vals = []
                for v in inputs.values():
                    if isinstance(v, str):
                        v = normalize_string(v)
                    if v == "" or v is None:
                        cleaned_vals.append("NULL")
                    else:
                        cleaned_vals.append("'" + str(v).replace("'", "''") + "'")
                vals_sql = ", ".join(cleaned_vals)
                insert_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                session.sql(insert_sql).collect()
                log_change(main_table, "INSERT", None, {k: normalize_string(v) if isinstance(v, str) else v for k, v in inputs.items()})
                st.success("Record inserted into TEMP and logged.")

        st.subheader("Update Record (in TEMP Table)")
        with st.form("update_form_" + table_key):
            # For composite keys show multiple inputs; else single input
            key_inputs = {}
            if isinstance(key_cols, (list, tuple)):
                cols_ui = st.columns(len(key_cols))
                for i, kc in enumerate(key_cols):
                    with cols_ui[i]:
                        val = st.text_input(kc + " value")
                        key_inputs[kc] = val
            else:
                key_inputs[key_cols] = st.text_input(f"{key_cols} to Update")

            upd_col = st.selectbox("Column to Update", [c for c in required_cols if (not isinstance(key_cols, str) or c != key_cols)])
            new_value = st.text_input("New Value")
            submit_upd = st.form_submit_button("Update Record")
            if submit_upd:
                # read old value from temp_table using built WHERE clause
                where_clause = build_where_from_key_inputs(key_cols, key_inputs)
                old_val = None
                if where_clause:
                    try:
                        old_val_df = session.sql("SELECT " + upd_col + " FROM " + temp_table + " WHERE " + where_clause).to_pandas()
                        old_val = old_val_df.iloc[0, 0] if not old_val_df.empty else None
                    except Exception:
                        old_val = None
                # prepare escaped new value
                escaped_new_value = "" if new_value is None else str(normalize_string(new_value)).replace("'", "''")
                # perform update
                if where_clause:
                    update_sql = "UPDATE " + temp_table + " SET " + upd_col + " = '" + escaped_new_value + "' WHERE " + where_clause
                else:
                    st.error("Could not build WHERE clause for update - please provide key values.")
                    update_sql = None
                if update_sql:
                    session.sql(update_sql).collect()
                    log_change(main_table, "UPDATE", {upd_col: old_val}, {upd_col: new_value})
                    st.success("Record updated in TEMP and logged.")

        st.subheader("Delete Record (from TEMP Table)")
        with st.form("delete_form_" + table_key):
            # For composite keys show multiple inputs; else single input
            del_key_inputs = {}
            if isinstance(key_cols, (list, tuple)):
                cols_ui = st.columns(len(key_cols))
                for i, kc in enumerate(key_cols):
                    with cols_ui[i]:
                        val = st.text_input(kc + " value (for delete)")
                        del_key_inputs[kc] = val
            else:
                del_key_inputs[key_cols] = st.text_input(f"{key_cols} to Delete")

            confirm = st.checkbox("Confirm Delete")
            submit_del = st.form_submit_button("Delete Record")
            if submit_del and confirm:
                where_clause = build_where_from_key_inputs(key_cols, del_key_inputs)
                old_val = None
                if where_clause:
                    try:
                        old_val_df = session.sql("SELECT * FROM " + temp_table + " WHERE " + where_clause).to_pandas()
                        old_val = old_val_df.to_dict(orient="records")[0] if not old_val_df.empty else None
                    except Exception:
                        old_val = None
                if not where_clause:
                    st.error("Could not build WHERE clause for delete - please provide key values.")
                else:
                    delete_sql = "DELETE FROM " + temp_table + " WHERE " + where_clause
                    session.sql(delete_sql).collect()
                    log_change(main_table, "DELETE", old_val, None)
                    st.success("Record deleted from TEMP and logged.")
            elif submit_del:
                st.warning("Please confirm delete before proceeding.")


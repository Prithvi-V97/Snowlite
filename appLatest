                    if len(parts) == 3:
                        db_name, schema_name, tbl_name = parts
                        meta_q = (
                            "SELECT column_name, data_type FROM "
                            f"{db_name}.information_schema.columns WHERE table_name = '{tbl_name}' AND table_schema = '{schema_name}'"
                        )
                        meta_df = session.sql(meta_q).to_pandas()
                        table_col_types = {r["COLUMN_NAME"].upper(): str(r["DATA_TYPE"]).upper() for _, r in meta_df.iterrows()}
                except Exception:
                    table_col_types = {}

                cols_in_file = list(excel_df.columns)
                if table_col_types:
                    cols_to_insert = [c for c in cols_in_file if c in table_col_types]

def fetch_table_column_types(table_full_name):
    """Return a mapping UPPERCASE column_name -> DATA_TYPE for the given table."""
    ensure_session()
    try:
        parts = table_full_name.split(".")
        if len(parts) == 3:
            db_name, schema_name, tbl_name = parts
            q = (
                "SELECT column_name, data_type FROM "
                f"{db_name}.information_schema.columns "
                f"WHERE table_name = '{tbl_name}' AND table_schema = '{schema_name}'"
            )
            meta = session.sql(q).to_pandas()
            return {r["COLUMN_NAME"].upper(): str(r["DATA_TYPE"]).upper() for _, r in meta.iterrows()}
    except Exception:
        pass
    return {}


def coerce_value_for_column(col, raw_v, col_types):
    """Coerce raw_v into SQL-ready literal depending on column type; handle time-only strings."""
    try:
        if isinstance(raw_v, str):
            raw_v = normalize_string(raw_v)
        try:
            if pd.isna(raw_v):
                raw_v = None
        except Exception:
            pass

        dtype = col_types.get(col.upper(), "")

        if dtype and ("TIMESTAMP" in dtype or "DATE" in dtype or "TIME" in dtype):
            if raw_v is None or raw_v == "":
                return "NULL"
            dt = pd.to_datetime(raw_v, errors="coerce", dayfirst=False)
            if pd.isna(dt):
                time_only_pattern = r"^\s*\d{1,2}:\d{2}(?::\d{2}(?:\.\d+)?)?\s*$"
                if isinstance(raw_v, str) and re.match(time_only_pattern, raw_v):
                    today_str = datetime.now().strftime("%Y-%m-%d")
                    candidate = f"{today_str} {raw_v}"
                    dt = pd.to_datetime(candidate, errors="coerce", dayfirst=False)
            if pd.isna(dt):
                return "NULL"
            val_str = dt.strftime("%Y-%m-%d %H:%M:%S")
            return sql_literal(val_str)

        if dtype and any(x in dtype for x in ("NUMBER", "INT", "DECIMAL", "NUMERIC", "FLOAT", "DOUBLE")):
            if raw_v is None or raw_v == "":
                return "NULL"
            try:
                num = float(raw_v)
                return str(int(num)) if num.is_integer() else str(num)
            except Exception:
                return "NULL"

        if raw_v is None or raw_v == "":
            return "NULL"
        return sql_literal(raw_v)
    except Exception:
        return "NULL"


def get_row_key(row, key_cols):
    """
    Return stable key for a row (tuple for composite keys, string for single).
    NORMALIZATION: remove NBSP, collapse spaces, UPPERCASE so keys match robustly.
    """
    def norm_value(v):
        if v is None:
            return ""
        if isinstance(v, str):
            v2 = normalize_string(v)
            if v2 is None:
                return ""
            return v2.upper()
        try:
            if pd.isna(v):
                return ""
        except Exception:
            pass
        return str(v).upper()

    if isinstance(key_cols, (list, tuple)):
        parts = []
        for k in key_cols:
            v = None
            try:
                v = row.get(k)
            except Exception:
                v = None
            if v is None and hasattr(row, "index"):
                for colname in row.index:
                    try:
                        if str(colname).lower() == str(k).lower():
                            v = row[colname]
                            break
                    except Exception:
                        continue
            parts.append(norm_value(v))
        return tuple(parts)
    else:
        k = key_cols
        v = None
        try:
            v = row.get(k)
        except Exception:
            v = None
        if v is None and hasattr(row, "index"):
            for colname in row.index:
                try:
                    if str(colname).lower() == str(k).lower():
                        v = row[colname]
                        break
                except Exception:
                    continue
        return norm_value(v)


def get_series_value(series_row, col):
    """Robustly get a value from a pandas Series row (case-insensitive fallback)."""
    v = None
    try:
        v = series_row.get(col)
    except Exception:
        v = None
    if v is None and hasattr(series_row, "index"):
        for colname in series_row.index:
            try:
                if str(colname).lower() == str(col).lower():
                    v = series_row[colname]
                    break
            except Exception:
                continue
    if isinstance(v, str):
        v = normalize_string(v)
    else:
        try:
            if pd.isna(v):
                v = None
        except Exception:
            pass
    return v


def build_where_from_key_inputs(key_cols, inputs_map):
    """Build WHERE clause from key inputs map."""
    parts = []
    if isinstance(key_cols, (list, tuple)):
        for kc in key_cols:
            v = inputs_map.get(kc, None)
            if v is None or v == "":
                parts.append(f"({kc} IS NULL OR {kc} = '')")
            else:
                esc = str(v).replace("'", "''")
                parts.append(f"{kc} = '{esc}'")
    else:
        v = inputs_map.get(key_cols, None)
        if v is None or v == "":
            parts.append(f"({key_cols} IS NULL OR {key_cols} = '')")
        else:
            esc = str(v).replace("'", "''")
            parts.append(f"{key_cols} = '{esc}'")
    return " AND ".join(parts) if parts else None


def build_where_from_dict(d):
    """Build a WHERE clause from a dict of col->value; handles None as IS NULL."""
    if not d or not isinstance(d, dict):
        return None
    parts = []
    for k, v in d.items():
        col = str(k).upper()
        if v is None or (isinstance(v, str) and v.strip() == ""):
            parts.append(f"{col} IS NULL")
        else:
            parts.append(f"{col} = {sql_literal(v)}")
    return " AND ".join(parts) if parts else None


# function defined before render_table_ui to avoid runtime errors
def fetch_main_table_sorted(table_name):
    ensure_session()
    try:
        df = session.table(table_name).to_pandas()
    except Exception:
        return pd.DataFrame()
    ts_candidates = [c for c in df.columns if c.lower() in ("approved_at", "changed_at", "created_at", "updated_at", "load_ts")]
    if ts_candidates:
        ts_col = ts_candidates[0]
        try:
            df[ts_col] = pd.to_datetime(df[ts_col], errors="coerce")
            df = df.sort_values(by=ts_col, ascending=False).reset_index(drop=True)
            return df
        except Exception:
            pass
    return df.reset_index(drop=True)



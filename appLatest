def render_table_ui(tab, table_key):
    ensure_session()

    info = main_tables[table_key]
    main_table = info["name"]
    temp_table = info["temp"]
    log_table = info["log"]
    required_cols = info["required_cols"]
    key_cols = info.get("key_col", required_cols[-1])

    with tab:
        # Approval Dashboard
        st.markdown("## Approval Dashboard")
        try:
            logs_df = session.sql(f"SELECT * FROM {log_table} WHERE approved = FALSE").to_pandas()
        except Exception as e:
            st.error("Could not fetch pending logs: " + str(e))
            logs_df = pd.DataFrame()

        pending_count = len(logs_df)
        st.markdown(f"### Pending Logs for {table_key} ({pending_count})")

        if logs_df.empty:
            st.success("No pending approvals.")
        else:
            logs_df.columns = [c.lower() for c in logs_df.columns]
            display_cols = [c for c in logs_df.columns if c not in ["approved", "approved_by", "approved_at"]]
            display_df = logs_df[display_cols].copy().reset_index(drop=True)

            approve_key = f"approve_col_{table_key}"
            if approve_key not in st.session_state or len(st.session_state[approve_key]) != len(display_df):
                st.session_state[approve_key] = [False] * len(display_df)

            if st.button("Select All Pending for Approval", key=f"select_all_{table_key}"):
                st.session_state[approve_key] = [True] * len(display_df)

            display_df["approve"] = st.session_state[approve_key]

            column_config = {col: st.column_config.Column(disabled=True) for col in display_df.columns if col != "approve"}
            column_config["approve"] = st.column_config.CheckboxColumn("Approve", help="Tick to approve this record", width=80)

            edited_logs = st.data_editor(
                display_df,
                use_container_width=True,
                height=300,
                column_config=column_config,
                hide_index=True,
                key=f"data_editor_logs_{table_key}"
            )

            if "approve" in edited_logs.columns:
                st.session_state[approve_key] = list(edited_logs["approve"])

            # Approve Selected Records handler
            if st.button(f"Approve Selected Records for {table_key}"):
                ensure_session()
                try:
                    logs_db = session.sql(f"SELECT * FROM {log_table} WHERE approved = FALSE").to_pandas()
                except Exception as e:
                    st.error("Could not fetch logs for approval: " + str(e))
                    logs_db = pd.DataFrame()

                if logs_db.empty:
                    st.info("No pending logs at approval time.")
                else:
                    logs_db.columns = [c.lower() for c in logs_db.columns]

                    def db_row_key(r):
                        t = r.get("table_name") if r.get("table_name") is not None else ""
                        a = r.get("action") if r.get("action") is not None else ""
                        cb = r.get("changed_by") if r.get("changed_by") is not None else ""
                        ch = r.get("changed_at")
                        try:
                            ch_iso = ch.isoformat() if hasattr(ch, "isoformat") else str(ch)
                        except Exception:
                            ch_iso = str(ch)
                        return (str(t), str(a), str(cb), str(ch_iso))

                    db_key_map = {}
                    for _, r in logs_db.iterrows():
                        key = db_row_key(r)
                        db_key_map.setdefault(key, []).append(r)

                    to_approve = edited_logs[edited_logs["approve"] == True]
                    if to_approve.empty:
                        st.warning("No rows selected for approval.")
                    else:
                        processed = 0
                        errors = []

                        for _, picked in to_approve.iterrows():
                            table_name = picked.get("table_name")
                            action = picked.get("action")
                            changed_by = picked.get("changed_by")
                            changed_at = picked.get("changed_at")
                            try:
                                changed_at_iso = changed_at.isoformat() if hasattr(changed_at, "isoformat") else str(changed_at)
                            except Exception:
                                changed_at_iso = str(changed_at)
                            lookup_key = (str(table_name), str(action), str(changed_by), str(changed_at_iso))

                            matched = db_key_map.get(lookup_key)
                            if not matched:
                                msg = "No matching DB log found for selected row: " + str(lookup_key)
                                errors.append(msg)
                                st.warning(msg)
                                continue

                            db_row = matched.pop(0)
                            log_id = db_row.get("log_id")
                            new_value_db = db_row.get("new_value")
                            old_value_db = db_row.get("old_value")
                            table_name_db = db_row.get("table_name")
                            action_db = db_row.get("action")

                            # find mapping
                            main_info = None
                            for k, inf in main_tables.items():
                                if inf.get("name") == table_name_db:
                                    main_info = inf
                                    break
                            if not main_info:
                                msg = f"No main mapping found for {table_name_db} (log_id={log_id})"
                                errors.append(msg)
                                st.error(msg)
                                continue

                            main_table_name = main_info.get("name")
                            required_cols_local = main_info.get("required_cols")
                            main_col_types = fetch_table_column_types(main_table_name)

                            parsed_new = parse_new_value(new_value_db) if new_value_db is not None else {}
                            parsed_old = parse_new_value(old_value_db) if old_value_db is not None else {}
                            act = str(action_db).upper() if action_db is not None else "INSERT"

                            try:
                                # Apply to main table according to action
                                if act == "INSERT":
                                    cols_from_new = list(parsed_new.keys()) if isinstance(parsed_new, dict) and parsed_new else required_cols_local
                                    vals_parts = []
                                    for col in cols_from_new:
                                        raw = parsed_new.get(col) if isinstance(parsed_new, dict) else None
                                        if raw is None and isinstance(parsed_new, dict):
                                            raw = parsed_new.get(col.lower(), parsed_new.get(col.upper(), None))
                                        vals_parts.append(coerce_value_for_column(col, raw, main_col_types))
                                    insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(cols_from_new) + ") VALUES (" + ", ".join(vals_parts) + ")"
                                    session.sql(insert_sql).collect()
                                    processed += 1

                                    # clear temp row for this new value
                                    try:
                                        temp_where = build_where_from_dict(parsed_new)
                                        if temp_where:
                                            session.sql("DELETE FROM " + temp_table + " WHERE " + temp_where).collect()
                                    except Exception as e:
                                        errors.append(f"Could not clear TEMP for log_id={log_id}: {e}")

                                elif act == "UPDATE":
                                    set_clause = None
                                    where_clause = None
                                    if isinstance(parsed_new, dict):
                                        set_parts = []
                                        for kcol, vcol in parsed_new.items():
                                            set_parts.append(f"{kcol.upper()} = {coerce_value_for_column(kcol, vcol, main_col_types)}")
                                        set_clause = ", ".join(set_parts) if set_parts else None
                                    if isinstance(parsed_old, dict):
                                        where_parts = []
                                        for kcol, vcol in parsed_old.items():
                                            if vcol is None:
                                                where_parts.append(f"{kcol.upper()} IS NULL")
                                            else:
                                                where_parts.append(f"{kcol.upper()} = {coerce_value_for_column(kcol, vcol, main_col_types)}")
                                        where_clause = " AND ".join(where_parts) if where_parts else None

                                    if set_clause and where_clause:
                                        update_sql = "UPDATE " + main_table_name + " SET " + set_clause + " WHERE " + where_clause
                                        session.sql(update_sql).collect()
                                        processed += 1

                                        # clear temp row for this new value
                                        try:
                                            temp_where = build_where_from_dict(parsed_new)
                                            if temp_where:
                                                session.sql("DELETE FROM " + temp_table + " WHERE " + temp_where).collect()
                                        except Exception as e:
                                            errors.append(f"Could not clear TEMP for log_id={log_id}: {e}")

                                    else:
                                        # fallback: insert new if where clause insufficient
                                        cols_from_new = list(parsed_new.keys()) if isinstance(parsed_new, dict) and parsed_new else required_cols_local
                                        vals_parts = []
                                        for col in cols_from_new:
                                            raw = parsed_new.get(col) if isinstance(parsed_new, dict) else None
                                            if raw is None and isinstance(parsed_new, dict):
                                                raw = parsed_new.get(col.lower(), parsed_new.get(col.upper(), None))
                                            vals_parts.append(coerce_value_for_column(col, raw, main_col_types))
                                        insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(cols_from_new) + ") VALUES (" + ", ".join(vals_parts) + ")"
                                        session.sql(insert_sql).collect()
                                        processed += 1

                                        try:
                                            temp_where = build_where_from_dict(parsed_new)
                                            if temp_where:
                                                session.sql("DELETE FROM " + temp_table + " WHERE " + temp_where).collect()
                                        except Exception as e:
                                            errors.append(f"Could not clear TEMP for log_id={log_id}: {e}")

                                elif act == "DELETE":
                                    where_clause = None
                                    if isinstance(parsed_old, dict):
                                        where_parts = []
                                        for kcol, vcol in parsed_old.items():
                                            if vcol is None:
                                                where_parts.append(f"{kcol.upper()} IS NULL")
                                            else:
                                                where_parts.append(f"{kcol.upper()} = {coerce_value_for_column(kcol, vcol, main_col_types)}")
                                        where_clause = " AND ".join(where_parts) if where_parts else None
                                    if where_clause:
                                        delete_sql = "DELETE FROM " + main_table_name + " WHERE " + where_clause
                                        session.sql(delete_sql).collect()
                                        processed += 1

                                        # clear temp row for this delete
                                        try:
                                            temp_where = build_where_from_dict(parsed_old)
                                            if temp_where:
                                                session.sql("DELETE FROM " + temp_table + " WHERE " + temp_where).collect()
                                        except Exception as e:
                                            errors.append(f"Could not clear TEMP for log_id={log_id}: {e}")
                                    else:
                                        # fallback: try parsed_new as where
                                        if isinstance(parsed_new, dict):
                                            where_parts = []
                                            for kcol, vcol in parsed_new.items():
                                                if vcol is None:
                                                    where_parts.append(f"{kcol.upper()} IS NULL")
                                                else:
                                                    where_parts.append(f"{kcol.upper()} = {coerce_value_for_column(kcol, vcol, main_col_types)}")
                                            where_clause2 = " AND ".join(where_parts) if where_parts else None
                                            if where_clause2:
                                                session.sql("DELETE FROM " + main_table_name + " WHERE " + where_clause2).collect()
                                                processed += 1
                                                try:
                                                    temp_where = build_where_from_dict(parsed_new)
                                                    if temp_where:
                                                        session.sql("DELETE FROM " + temp_table + " WHERE " + temp_where).collect()
                                                except Exception as e:
                                                    errors.append(f"Could not clear TEMP for log_id={log_id}: {e}")
                                            else:
                                                msg = f"Cannot determine WHERE clause for DELETE for log_id={log_id}; skipped."
                                                errors.append(msg)
                                                st.warning(msg)
                                        else:
                                            msg = f"Cannot determine WHERE clause for DELETE for log_id={log_id}; skipped."
                                            errors.append(msg)
                                            st.warning(msg)
                                else:
                                    # default behavior - insert
                                    cols_from_new = list(parsed_new.keys()) if isinstance(parsed_new, dict) and parsed_new else required_cols_local
                                    vals_parts = []
                                    for col in cols_from_new:
                                        raw = parsed_new.get(col) if isinstance(parsed_new, dict) else None
                                        if raw is None and isinstance(parsed_new, dict):
                                            raw = parsed_new.get(col.lower(), parsed_new.get(col.upper(), None))
                                        vals_parts.append(coerce_value_for_column(col, raw, main_col_types))
                                    insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(cols_from_new) + ") VALUES (" + ", ".join(vals_parts) + ")"
                                    session.sql(insert_sql).collect()
                                    processed += 1
                                    try:
                                        temp_where = build_where_from_dict(parsed_new)
                                        if temp_where:
                                            session.sql("DELETE FROM " + temp_table + " WHERE " + temp_where).collect()
                                    except Exception as e:
                                        errors.append(f"Could not clear TEMP for log_id={log_id}: {e}")

                                # mark log approved
                                try:
                                    if log_id is not None:
                                        try:
                                            lid = int(log_id)
                                            session.sql("UPDATE " + log_table + " SET approved = TRUE, approved_by = 'business_user', approved_at = CURRENT_TIMESTAMP WHERE log_id = " + str(lid) + " AND approved = FALSE").collect()
                                        except Exception:
                                            table_name_esc = str(table_name_db).replace("'", "''")
                                            changed_at_str = str(db_row.get("changed_at")).replace("'", "''")
                                            session.sql("UPDATE " + log_table + " SET approved = TRUE, approved_by = 'business_user', approved_at = CURRENT_TIMESTAMP WHERE table_name = '" + table_name_esc + "' AND changed_at = '" + changed_at_str + "'").collect()
                                    else:
                                        table_name_esc = str(table_name_db).replace("'", "''")
                                        changed_at_str = str(db_row.get("changed_at")).replace("'", "''")
                                        session.sql("UPDATE " + log_table + " SET approved = TRUE, approved_by = 'business_user', approved_at = CURRENT_TIMESTAMP WHERE table_name = '" + table_name_esc + "' AND changed_at = '" + changed_at_str + "'").collect()
                                except Exception as e:
                                    errors.append("Could not mark log approved for log_id=" + str(log_id) + ": " + str(e))

                            except Exception as e:
                                errors.append("Error processing log_id=" + str(log_id) + ": " + str(e))
                                st.error("Error processing log_id=" + str(log_id) + ": " + str(e))
                                continue

                        st.success("Approval run complete. Processed " + str(processed) + " item(s).")
                        if errors:
                            st.warning("Some items had issues; check messages above.")

                        try:
                            if hasattr(st, "experimental_rerun"):
                                st.experimental_rerun()
                            elif hasattr(st, "rerun"):
                                st.rerun()
                            else:
                                import streamlit.components.v1 as components
                                components.html("<script>window.location.reload()</script>", height=0)
                        except Exception:
                            import streamlit.components.v1 as components
                            components.html("<script>window.location.reload()</script>", height=0)

        st.markdown("---")
        # Main Table display + edit toggle
        st.subheader("Main Table: " + main_table)
        main_df = fetch_main_table_sorted(main_table)

        if main_df is None or main_df.empty:
            st.info("Main table empty or could not be fetched.")
        else:
            st.markdown("**Tip:** Click 'Enable Editing' to toggle edit mode. When edit mode is ON, you can edit cells. Click 'Send Edits to Approval' to send changed rows to TEMP & log them.")

            edit_key = f"main_edit_enabled_{table_key}"
            if edit_key not in st.session_state:
                st.session_state[edit_key] = False

            toggle_label = "Disable Editing" if st.session_state[edit_key] else "Enable Editing"
            if st.button(toggle_label, key=f"btn_edit_{table_key}"):
                st.session_state[edit_key] = not st.session_state[edit_key]

            if st.session_state[edit_key]:
                st.success("Edit mode enabled — edit cells and then click 'Send Edits to Approval'.")
            else:
                st.info("Edit mode disabled — table is read-only.")

            # ------------------------
            # Prepare display_df and editor
            # ------------------------
            display_df = main_df.copy().reset_index(drop=True)

            # Remove duplicate columns if any (keep first occurrence)
            display_df = display_df.loc[:, ~display_df.columns.duplicated()]

            # Column config: editable depends on edit mode
            column_config = {}
            for c in display_df.columns:
                column_config[c] = st.column_config.Column(disabled=not bool(st.session_state[edit_key]))

            # Render editor (AG-Grid preferred)
            if AGGRID_AVAILABLE:
                gb = GridOptionsBuilder.from_dataframe(display_df)
                gb.configure_default_column(editable=bool(st.session_state[edit_key]), resizable=True, filter=True, sortable=True)
                grid_opts = gb.build()
                grid_resp = AgGrid(
                    display_df,

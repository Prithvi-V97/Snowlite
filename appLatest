                    if not new_norm.empty:
                        # Build new_index but retain mapping to the original key by row position.
                        # This helps when key columns were edited (so new key != old key).
                        # We'll use row position to find the corresponding original key if available.
                        new_rows = list(new_norm.iterrows())
                        for idx, (_i, r) in enumerate(new_rows):
                            # prefer the original key at same row index (if present)
                            if idx < len(orig_keys):
                                orig_key_for_this_row = orig_keys[idx]
                            else:
                                # fallback: compute key from the new row
                                orig_key_for_this_row = get_row_key(r, key_cols)
                            # store mapping using a special composite key: orig_key_for_this_row
                            new_index[orig_key_for_this_row] = r



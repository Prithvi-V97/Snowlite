                else:
                    edited_data = st.data_editor(
                        main_df,
                        use_container_width=True,
                        num_rows="dynamic",
                        key=f"data_editor_main_{table_key}"
                    )

            # Send Edits to Approval (paired-update logic)
            if st.button("Send Edits to Approval", key=f"send_edits_{table_key}"):
                try:
                    orig = main_df.copy()
                    new = edited_data.copy()

                    orig_index = {}
                    new_index = {}

                    if not orig.empty:
                        for _, r in orig.iterrows():
                            k = get_row_key(r, key_cols)
                            orig_index[k] = r
                    if not new.empty:
                        for _, r in new.iterrows():
                            k = get_row_key(r, key_cols)
                            new_index[k] = r

                    def is_empty_key(k):
                        if isinstance(k, tuple):
                            return all((str(p) == "" or str(p).lower() == "nan") for p in k)
                        if isinstance(k, str):
                            return (k == "" or k.lower() == "nan")
                        return False

                    deleted_keys = [k for k in orig_index.keys() if k not in new_index.keys()]
                    inserted_keys = [k for k in new_index.keys() if (k not in orig_index.keys() or is_empty_key(k))]
                    updated_keys = []
                    for k in orig_index.keys():
                        if k in new_index:
                            o = orig_index[k]
                            n = new_index[k]
                            changed = False
                            for c in orig.columns:
                                o_val = get_series_value(o, c)
                                n_val = get_series_value(n, c)
                                if (o_val is None and n_val is None) or (o_val == n_val):
                                    continue
                                changed = True
                                break
                            if changed:
                                updated_keys.append(k)

                    paired_updates = []
                    if deleted_keys and inserted_keys:
                        non_key_cols = [c for c in orig.columns if (not (isinstance(key_cols, (list, tuple)) and c in key_cols) and not (isinstance(key_cols, str) and c == key_cols))]
                        if not non_key_cols:
                            if isinstance(key_cols, (list, tuple)):
                                non_key_cols = [c for c in required_cols if c not in key_cols]
                            else:
                                non_key_cols = [c for c in required_cols if c != key_cols]

                        def non_key_signature(row):
                            sig = []
                            for col in non_key_cols:
                                v = get_series_value(row, col)
                                sig.append('' if v is None else str(v))
                            return tuple(sig)

                        deleted_sigs = {dk: non_key_signature(orig_index[dk]) for dk in deleted_keys}
                        inserted_sigs = {ik: non_key_signature(new_index[ik]) for ik in inserted_keys}

                        used_inserts = set()
                        used_deletes = set()
                        for dk, dsig in deleted_sigs.items():
                            for ik, isig in inserted_sigs.items():
                                if ik in used_inserts:
                                    continue
                                if dsig == isig:
                                    paired_updates.append((dk, ik))
                                    used_deletes.add(dk)
                                    used_inserts.add(ik)
                                    break

                        deleted_keys = [k for k in deleted_keys if k not in used_deletes]
                        inserted_keys = [k for k in inserted_keys if k not in used_inserts]

                    processed = 0
                    errors = []

                    # Process paired updates
                    for old_k, new_k in paired_updates:
                        try:
                            orig_row = orig_index.get(old_k)
                            new_row = new_index.get(new_k)
                            vals_list = []
                            for col in required_cols:
                                v = get_series_value(new_row, col) if new_row is not None else None
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    vals_list.append("'" + str(v).replace("'", "''") + "'")
                            cols_sql = ", ".join(required_cols)
                            vals_sql = ", ".join(vals_list)
                            insert_temp_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_temp_sql).collect()
                            old_d = {}
                            new_d = {}
                            for col in required_cols:
                                o = get_series_value(orig_row, col) if orig_row is not None else None
                                n = get_series_value(new_row, col) if new_row is not None else None
                                old_d[col] = o
                                new_d[col] = n
                            log_change(main_table, "UPDATE", old_d, new_d)
                            processed += 1
                        except Exception as e:
                            errors.append("Error processing paired update old_key=" + str(old_k) + " new_key=" + str(new_k) + ": " + str(e))

                    # Unchanged-key updates
                    for k in updated_keys:
                        try:
                            orig_row = orig_index.get(k)
                            new_row = new_index.get(k)
                            vals_list = []
                            for col in required_cols:
                                v = get_series_value(new_row, col) if new_row is not None else None
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    vals_list.append("'" + str(v).replace("'", "''") + "'")
                            cols_sql = ", ".join(required_cols)
                            vals_sql = ", ".join(vals_list)
                            insert_temp_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_temp_sql).collect()
                            old_d = {}
                            new_d = {}
                            for col in required_cols:
                                o = get_series_value(orig_row, col) if orig_row is not None else None
                                n = get_series_value(new_row, col) if new_row is not None else None
                                old_d[col] = o
                                new_d[col] = n
                            log_change(main_table, "UPDATE", old_d, new_d)
                            processed += 1
                        except Exception as e:
                            errors.append("Error processing update key=" + str(k) + ": " + str(e))

                    # Inserts
                    for ik in inserted_keys:
                        try:
                            new_row = new_index.get(ik)
                            vals_list = []
                            for col in required_cols:
                                v = get_series_value(new_row, col) if new_row is not None else None
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    vals_list.append("'" + str(v).replace("'", "''") + "'")
                            cols_sql = ", ".join(required_cols)
                            vals_sql = ", ".join(vals_list)
                            insert_temp_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_temp_sql).collect()
                            nv = new_row.to_dict() if hasattr(new_row, "to_dict") else new_row
                            log_change(main_table, "INSERT", None, nv)
                            processed += 1
                        except Exception as e:
                            errors.append("Error processing insert key=" + str(ik) + ": " + str(e))

                    # Deletes
                    for dk in deleted_keys:
                        try:
                            old_row = orig_index.get(dk)
                            vals_list = []
                            for col in required_cols:
                                v = get_series_value(old_row, col) if old_row is not None else None
                                if v is None or v == "":
                                    vals_list.append("NULL")
                                else:
                                    vals_list.append("'" + str(v).replace("'", "''") + "'")
                            cols_sql = ", ".join(required_cols)
                            vals_sql = ", ".join(vals_list)
                            insert_temp_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                            session.sql(insert_temp_sql).collect()
                            log_change(main_table, "DELETE", old_row.to_dict() if hasattr(old_row, "to_dict") else old_row, None)
                            processed += 1
                        except Exception as e:
                            errors.append("Error processing delete key=" + str(dk) + ": " + str(e))

                    st.success("Sent edits to TEMP and logged for approval. Processed: " + str(processed))
                    if errors:
                        for er in errors:
                            st.warning(er)

                except Exception as e:
                    st.error("Error processing edits for approval: " + str(e))


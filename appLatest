st.markdown("## Approval Dashboard")

try:
    pending_logs = session.sql("SELECT * FROM " + LOG_TABLE + " WHERE approved = FALSE").to_pandas()
except Exception as e:
    st.error("Could not fetch pending logs: " + str(e))
    pending_logs = pd.DataFrame()

# Show pending count
total_pending = len(pending_logs)
st.markdown(f"### Pending Records for Approval: **{total_pending}**")

if pending_logs.empty:
    st.success("No pending approvals.")
else:
    pending_logs.columns = [c.lower() for c in pending_logs.columns]
    display_cols = [c for c in pending_logs.columns if c not in ["approved", "approved_by", "approved_at"]]
    display_df = pending_logs[display_cols].copy().reset_index(drop=True)
    if "approve" not in display_df.columns:
        display_df["approve"] = False

    edited_df = st.data_editor(
        display_df,
        use_container_width=True,
        height=400,
        column_config={
            "approve": st.column_config.CheckboxColumn(
                "Approve",
                help="Tick to approve this record",
                width=80
            )
        },
        hide_index=True
    )

    # -------------------------
    # APPROVAL HANDLER (fixed for INSERT/UPDATE/DELETE)
    # -------------------------
    if st.button("Approve Selected Records"):
        # re-fetch authoritative pending logs from DB
        try:
            pending_logs_db = session.sql("SELECT * FROM " + LOG_TABLE + " WHERE approved = FALSE").to_pandas()
        except Exception as e:
            st.error("Could not fetch pending logs for approval: " + str(e))
            pending_logs_db = pd.DataFrame()

        if pending_logs_db.empty:
            st.info("No pending logs found in DB at approval time.")
        else:
            pending_logs_db.columns = [c.lower() for c in pending_logs_db.columns]

            # build map keyed by (table_name, action, changed_by, changed_at_iso)
            def db_row_key(r):
                t = r.get("table_name") if r.get("table_name") is not None else ""
                a = r.get("action") if r.get("action") is not None else ""
                cb = r.get("changed_by") if r.get("changed_by") is not None else ""
                ch = r.get("changed_at")
                try:
                    ch_iso = ch.isoformat() if hasattr(ch, "isoformat") else str(ch)
                except Exception:
                    ch_iso = str(ch)
                return (str(t), str(a), str(cb), str(ch_iso))

            db_key_map = {}
            for _, r in pending_logs_db.iterrows():
                key = db_row_key(r)
                db_key_map.setdefault(key, []).append(r)

            to_approve = edited_df[edited_df["approve"] == True]
            if to_approve.empty:
                st.warning("No rows selected for approval.")
            else:
                processed = 0
                errors = []

                # helper to produce SQL literal or NULL
                def sql_literal(v):
                    try:
                        if pd.isna(v):
                            return "NULL"
                    except Exception:
                        pass
                    if v is None:
                        return "NULL"
                    if isinstance(v, (int, float, np.integer, np.floating)) and not isinstance(v, (bool, np.bool_)):
                        return str(v)
                    s = str(v)
                    if re.fullmatch(r"-?\d+(\.\d+)?", s.strip()):
                        return s.strip()
                    return "'" + s.replace("'", "''") + "'"

                # build WHERE/SET from dict helpers
                def build_where_from_dict(d):
                    if not isinstance(d, dict) or not d:
                        return None
                    parts = []
                    for k, v in d.items():
                        col = str(k).upper()
                        if v is None:
                            parts.append(col + " IS NULL")
                        else:
                            if isinstance(v, str):
                                v = v.replace("\u00A0", " ").strip()
                            parts.append(col + " = " + sql_literal(v))
                    return " AND ".join(parts) if parts else None

                def build_set_from_dict(d):
                    if not isinstance(d, dict) or not d:
                        return None
                    parts = []
                    for k, v in d.items():
                        col = str(k).upper()
                        if v is None:
                            parts.append(col + " = NULL")
                        else:
                            if isinstance(v, str):
                                v = v.replace("\u00A0", " ").strip()
                            parts.append(col + " = " + sql_literal(v))
                    return ", ".join(parts) if parts else None

                for _, edited_row in to_approve.iterrows():
                    table_name = edited_row.get("table_name")
                    action = edited_row.get("action")
                    changed_by = edited_row.get("changed_by")
                    changed_at = edited_row.get("changed_at")
                    try:
                        changed_at_iso = changed_at.isoformat() if hasattr(changed_at, "isoformat") else str(changed_at)
                    except Exception:
                        changed_at_iso = str(changed_at)
                    lookup_key = (str(table_name), str(action), str(changed_by), str(changed_at_iso))

                    matched = db_key_map.get(lookup_key)
                    if not matched:
                        msg = "No matching DB log found for selected row: " + str(lookup_key)
                        errors.append(msg)
                        st.warning(msg)
                        continue

                    db_row = matched.pop(0)
                    log_id = db_row.get("log_id")
                    new_value_db = db_row.get("new_value")
                    old_value_db = db_row.get("old_value")
                    table_name_db = db_row.get("table_name")
                    action_db = db_row.get("action")

                    # find main table mapping for the log's table_name_db
                    main_info = None
                    for k, info in main_tables.items():
                        if info.get("name") == table_name_db:
                            main_info = info
                            break
                    if not main_info:
                        msg = "No main mapping found for " + str(table_name_db) + " (log_id=" + str(log_id) + ")"
                        errors.append(msg)
                        st.error(msg)
                        continue

                    main_table_name = main_info.get("name")
                    required_cols = main_info.get("required_cols")

                    # parse new/old values into dicts (best-effort)
                    parsed_new = {}
                    parsed_old = {}

                    try:
                        if isinstance(new_value_db, dict):
                            parsed_new = new_value_db
                        elif new_value_db is not None:
                            s = str(new_value_db).strip()
                            if s.startswith("$$") and s.endswith("$$"):
                                s = s[2:-2].strip()
                            try:
                                parsed_new = json.loads(s)
                            except Exception:
                                try:
                                    parsed_new = json.loads(s.replace("'", '"'))
                                except Exception:
                                    try:
                                        parsed_new = ast.literal_eval(s)
                                    except Exception:
                                        parsed_new = {}
                    except Exception:
                        parsed_new = {}

                    try:
                        if isinstance(old_value_db, dict):
                            parsed_old = old_value_db
                        elif old_value_db is not None:
                            s2 = str(old_value_db).strip()
                            if s2.startswith("$$") and s2.endswith("$$"):
                                s2 = s2[2:-2].strip()
                            try:
                                parsed_old = json.loads(s2)
                            except Exception:
                                try:
                                    parsed_old = json.loads(s2.replace("'", '"'))
                                except Exception:
                                    try:
                                        parsed_old = ast.literal_eval(s2)
                                    except Exception:
                                        parsed_old = {}
                    except Exception:
                        parsed_old = {}

                    act = str(action_db).upper() if action_db is not None else "INSERT"

                    try:
                        if act == "INSERT":
                            # Insert new row using parsed_new; fallback to inserting NULLs for required_cols if missing
                            vals_parts = []
                            for col in required_cols:
                                val = None
                                if isinstance(parsed_new, dict):
                                    if col in parsed_new:
                                        val = parsed_new.get(col)
                                    elif col.lower() in parsed_new:
                                        val = parsed_new.get(col.lower())
                                    elif col.upper() in parsed_new:
                                        val = parsed_new.get(col.upper())
                                if isinstance(val, str):
                                    val = normalize_string(val)
                                if val is None or val == "":
                                    vals_parts.append("NULL")
                                else:
                                    vals_parts.append(sql_literal(val))
                            insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(required_cols) + ") VALUES (" + ", ".join(vals_parts) + ")"
                            session.sql(insert_sql).collect()
                            processed += 1

                        elif act == "UPDATE":
                            set_clause = build_set_from_dict(parsed_new)
                            where_clause = build_where_from_dict(parsed_old)
                            if set_clause and where_clause:
                                update_sql = "UPDATE " + main_table_name + " SET " + set_clause + " WHERE " + where_clause
                                session.sql(update_sql).collect()
                                processed += 1
                            else:
                                # fallback: insert new row if we cannot reliably identify which main row to update
                                vals_parts = []
                                for col in required_cols:
                                    val = None
                                    if isinstance(parsed_new, dict):
                                        if col in parsed_new:
                                            val = parsed_new.get(col)
                                        elif col.lower() in parsed_new:
                                            val = parsed_new.get(col.lower())
                                        elif col.upper() in parsed_new:
                                            val = parsed_new.get(col.upper())
                                    if isinstance(val, str):
                                        val = normalize_string(val)
                                    if val is None or val == "":
                                        vals_parts.append("NULL")
                                    else:
                                        vals_parts.append(sql_literal(val))
                                insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(required_cols) + ") VALUES (" + ", ".join(vals_parts) + ")"
                                session.sql(insert_sql).collect()
                                processed += 1

                        elif act == "DELETE":
                            where_clause = build_where_from_dict(parsed_old)
                            if where_clause:
                                delete_sql = "DELETE FROM " + main_table_name + " WHERE " + where_clause
                                session.sql(delete_sql).collect()
                                processed += 1
                            else:
                                where_clause2 = build_where_from_dict(parsed_new)
                                if where_clause2:
                                    session.sql("DELETE FROM " + main_table_name + " WHERE " + where_clause2).collect()
                                    processed += 1
                                else:
                                    msg = "Cannot determine WHERE clause for DELETE for log_id=" + str(log_id) + "; skipped."
                                    errors.append(msg)
                                    st.warning(msg)
                                    continue
                        else:
                            # unknown action: insert as fallback
                            vals_parts = []
                            for col in required_cols:
                                val = None
                                if isinstance(parsed_new, dict):
                                    if col in parsed_new:
                                        val = parsed_new.get(col)
                                    elif col.lower() in parsed_new:
                                        val = parsed_new.get(col.lower())
                                    elif col.upper() in parsed_new:
                                        val = parsed_new.get(col.upper())
                                if isinstance(val, str):
                                    val = normalize_string(val)
                                if val is None or val == "":
                                    vals_parts.append("NULL")
                                else:
                                    vals_parts.append(sql_literal(val))
                            insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(required_cols) + ") VALUES (" + ", ".join(vals_parts) + ")"
                            session.sql(insert_sql).collect()
                            processed += 1

                        # mark the log approved (prefer log_id)
                        try:
                            if log_id is not None:
                                try:
                                    lid = int(log_id)
                                    session.sql("UPDATE " + LOG_TABLE + " SET approved = TRUE, approved_by = 'business_user', approved_at = CURRENT_TIMESTAMP WHERE log_id = " + str(lid) + " AND approved = FALSE").collect()
                                except Exception:
                                    # fallback textual where

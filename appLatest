def normalize_string(s):
    """Replace NBSP with normal space and strip."""
    if s is None:
        return None
    if isinstance(s, str):
        return s.replace("\u00A0", " ").strip()
    return s

def read_uploaded_file(uploaded_file):
    """Read uploaded Excel/CSV and normalize strings."""
    try:
        if uploaded_file.name.endswith(".xlsx"):
            df = pd.read_excel(uploaded_file, engine="openpyxl")
        elif uploaded_file.name.endswith(".csv"):
            try:
                df = pd.read_csv(uploaded_file, encoding="utf-8")
            except UnicodeDecodeError:
                st.warning("File is not UTF-8 encoded. Trying ISO-8859-1...")
                df = pd.read_csv(uploaded_file, encoding="ISO-8859-1")
        else:
            st.error("Unsupported file format. Please upload .xlsx or .csv")
            return None
        df = df.applymap(lambda x: normalize_string(x) if isinstance(x, str) else x)
        return df
    except Exception as e:
        st.error("Error reading file: " + str(e))
        return None

def clean_for_json(obj):
    """Convert Python/pandas/numpy objects into JSON-serializable primitives."""
    if obj is None:
        return None
    try:
        if pd.isna(obj):
            return None
    except Exception:
        pass
    if isinstance(obj, (pd.Timestamp, datetime)):
        try:
            return obj.isoformat()
        except Exception:
            return str(obj)
    if isinstance(obj, date) and not isinstance(obj, datetime):
        return obj.isoformat()
    if isinstance(obj, (np.integer,)):
        return int(obj)
    if isinstance(obj, (np.floating,)):
        return float(obj)
    if isinstance(obj, (np.bool_,)):
        return bool(obj)
    if isinstance(obj, dict):
        return {str(k): clean_for_json(v) for k, v in obj.items()}
    if isinstance(obj, (list, tuple, set, pd.Series)):
        return [clean_for_json(v) for v in obj]
    if isinstance(obj, (str, int, float, bool)):
        return obj
    try:
        return str(obj)
    except Exception:
        return None

def find_log_table_for_main(main_table_name):
    for info in main_tables.values():
        if info["name"] == main_table_name:
            return info["log"]
    return None

def log_change(main_table_name, action, old_value=None, new_value=None):
    """Write an audit record to the appropriate log table for the main table name."""
    ensure_session()
    log_table = find_log_table_for_main(main_table_name)
    if not log_table:
        raise ValueError("No log table mapping found for " + str(main_table_name))
    cleaned_old = clean_for_json(old_value) if old_value is not None else None
    cleaned_new = clean_for_json(new_value) if new_value is not None else None
    old_json = json.dumps(cleaned_old) if cleaned_old is not None else None
    new_json = json.dumps(cleaned_new) if cleaned_new is not None else None
    old_sql_val = "$$ " + old_json + " $$" if old_json is not None else "NULL"
    new_sql_val = "$$ " + new_json + " $$" if new_json is not None else "NULL"
    insert_sql = (
        "INSERT INTO " + log_table +
        " (action, table_name, old_value, new_value, changed_by, changed_at, approved) VALUES ("
        "'" + str(action) + "', '" + str(main_table_name) + "', " + old_sql_val + ", " + new_sql_val +
        ", 'streamlit_user', CURRENT_TIMESTAMP, FALSE)"
    )
    try:
        session.sql(insert_sql).collect()
    except Exception as e:
        st.error("Failed to write to log table: " + str(e))

def parse_new_value(val):
    """Try multiple strategies to parse a JSON-like value stored in the log."""
    if val is None:
        return {}
    if isinstance(val, dict):
        return {k: (v.replace("\u00A0", " ").strip() if isinstance(v, str) else v) for k, v in val.items()}
    s = str(val).strip()
    if s.startswith("$$") and s.endswith("$$"):
        s = s[2:-2].strip()
    try:
        parsed = json.loads(s)
        if isinstance(parsed, dict):
            return {k: (v.replace("\u00A0", " ").strip() if isinstance(v, str) else v) for k, v in parsed.items()}
    except Exception:
        pass
    try:
        parsed = json.loads(s.replace("'", '"'))
        if isinstance(parsed, dict):
            return {k: (v.replace("\u00A0", " ").strip() if isinstance(v, str) else v) for k, v in parsed.items()}
    except Exception:
        pass
    try:
        parsed = ast.literal_eval(s)
        if isinstance(parsed, dict):
            return {k: (v.replace("\u00A0", " ").strip() if isinstance(v, str) else v) for k, v in parsed.items()}
    except Exception:
        pass
    return {}

def fetch_table_column_types(table_full_name):
    """
    Return a dict mapping UPPERCASE column_name -> DATA_TYPE for a fully qualified table name like DB.SCHEMA.TABLE.
    If unable to fetch metadata, returns empty dict.
    """
    ensure_session()
    try:
        parts = table_full_name.split(".")
        if len(parts) == 3:
            db_name, schema_name, tbl_name = parts
            q = (
                "SELECT column_name, data_type FROM "
                f"{db_name}.information_schema.columns "
                f"WHERE table_name = '{tbl_name}' AND table_schema = '{schema_name}'"
            )
            cols_meta = session.sql(q).to_pandas()
            return {r['COLUMN_NAME'].upper(): str(r['DATA_TYPE']).upper() for _, r in cols_meta.iterrows()}
    except Exception:
        pass
    return {}

def fetch_main_table_sorted(table_name):
    """Fetch a main table and attempt to sort by a timestamp-like column so newest rows appear on top."""
    ensure_session()
    try:
        df = session.table(table_name).to_pandas()
    except Exception:
        return pd.DataFrame()
    ts_candidates = [c for c in df.columns if c.lower() in ("approved_at", "changed_at", "created_at", "updated_at", "load_ts")]
    if ts_candidates:
        ts_col = ts_candidates[0]
        try:
            df[ts_col] = pd.to_datetime(df[ts_col], errors="coerce")
            df = df.sort_values(by=ts_col, ascending=False).reset_index(drop=True)
            return df
        except Exception:
            pass
    return df.reset_index(drop=True)

def sql_literal(v):
    """Return a SQL-safe literal (or NULL) for value v."""
    try:
        if pd.isna(v):
            return "NULL"
    except Exception:
        pass
    if v is None:
        return "NULL"
    if isinstance(v, (int, float, np.integer, np.floating)) and not isinstance(v, (bool, np.bool_)):
        return str(v)
    s = str(v)
    if re.fullmatch(r"-?\d+(\.\d+)?", s.strip()):
        return s.strip()
    return "'" + s.replace("'", "''") + "'"

def coerce_value_for_column(col, raw_v, col_types):
    """
    Coerce raw_v into a SQL-ready literal string based on col_types mapping.
    Returns a string ready to be inserted in SQL (e.g. NULL, 123.45, or 'escaped').
    If coercion fails, returns 'NULL'.
    """
    try:
        # Normalize raw
        if isinstance(raw_v, str):
            raw_v = normalize_string(raw_v)
        try:
            if pd.isna(raw_v):
                raw_v = None
        except Exception:
            pass

        dtype = col_types.get(col.upper(), "")

        # Timestamp / date / time handling
        if dtype and ("TIMESTAMP" in dtype or "DATE" in dtype or "TIME" in dtype):
            if raw_v is None or raw_v == "":
                return "NULL"
            # Try parse
            dt = pd.to_datetime(raw_v, errors="coerce", dayfirst=False)
            if pd.isna(dt):
                # If looks like time-only (e.g., 20:34.5), try prefixing today's date
                time_only_pattern = r"^\s*\d{1,2}:\d{2}(?::\d{2}(?:\.\d+)?)?(?:\.\d+)?\s*$"
                if isinstance(raw_v, str) and re.match(time_only_pattern, raw_v):
                    today_str = datetime.now().strftime("%Y-%m-%d")
                    candidate = f"{today_str} {raw_v}"
                    dt = pd.to_datetime(candidate, errors="coerce", dayfirst=False)
            if pd.isna(dt):
                # Could not coerce => NULL to avoid crash
                return "NULL"
            # Format as full timestamp
            val_str = dt.strftime("%Y-%m-%d %H:%M:%S")
            return sql_literal(val_str)

        # Numeric
        if dtype and any(x in dtype for x in ("NUMBER", "INT", "DECIMAL", "NUMERIC", "FLOAT", "DOUBLE")):
            if raw_v is None or raw_v == "":
                return "NULL"
            try:
                num = float(raw_v)
                return str(int(num)) if num.is_integer() else str(num)
            except Exception:
                return "NULL"

        # Default: string
        if raw_v is None or raw_v == "":
            return "NULL"
        return sql_literal(raw_v)
    except Exception:
        return "NULL"

def get_row_key(row, key_cols):
    """
    Return a stable key for a row:
      - If key_cols is list/tuple: returns a tuple of normalized parts (hashable).
      - If key_cols is str: returns a normalized string.
    """
    if isinstance(key_cols, (list, tuple)):
        parts = []
        for k in key_cols:
            try:
                v = row.get(k)
            except Exception:
                v = None
                if hasattr(row, "__getitem__"):
                    if k in row:
                        v = row[k]
                    else:
                        for colname in row.index:
                            if str(colname).lower() == str(k).lower():
                                v = row[colname]
                                break
            if isinstance(v, str):
                v = normalize_string(v)
            else:
                try:
                    if pd.isna(v):
                        v = None
                except Exception:
                    pass
            parts.append('' if v is None else str(v))
        return tuple(parts)
    else:
        k = key_cols
        try:
            v = row.get(k)
        except Exception:
            v = None
            if hasattr(row, "__getitem__"):
                if k in row:
                    v = row[k]
                else:
                    for colname in row.index:
                        if str(colname).lower() == str(k).lower():
                            v = row[colname]
                            break
        if isinstance(v, str):
            v = normalize_string(v)
        else:
            try:
                if pd.isna(v):
                    v = None
            except Exception:
                pass
        return '' if v is None else str(v)

def get_series_value(row, col):
    """
    Robustly fetch a column value from a pandas Series (row).
    - tries row.get(col)
    - falls back to case-insensitive match on index
    - normalizes NBSP and strips strings
    - converts pd.NA / np.nan to None
    """
    v = None
    try:
        v = row.get(col)
    except Exception:
        v = None

    if v is None and hasattr(row, "index"):
        for colname in row.index:
            try:
                if str(colname).lower() == str(col).lower():
                    v = row[colname]
                    break
            except Exception:
                continue

    if isinstance(v, str):
        v = normalize_string(v)
    else:
        try:
            if pd.isna(v):
                v = None
        except Exception:
            pass

    return v

def build_where_from_key_inputs(key_cols, inputs_map):
    """
    Build a SQL WHERE clause from key inputs.
    - key_cols: str or list
    - inputs_map: dict mapping column -> user-provided value (already normalized strings or None)
    Returns a WHERE clause string (without leading WHERE) or None if nothing provided.
    """
    parts = []
    if isinstance(key_cols, (list, tuple)):
        for kc in key_cols:
            v = inputs_map.get(kc, None)
            if v is None or v == "":
                parts.append(f"({kc} IS NULL OR {kc} = '')")
            else:
                esc = str(v).replace("'", "''")
                parts.append(f"{kc} = '{esc}'")
    else:
        v = inputs_map.get(key_cols, None)
        if v is None or v == "":
            parts.append(f"({key_cols} IS NULL OR {key_cols} = '')")
        else:
            esc = str(v).replace("'", "''")
            parts.append(f"{key_cols} = '{esc}'")
    return " AND ".join(parts) if parts else None


def render_table_ui(tab, table_key):
    # ensure session at start
    ensure_session()

    info = main_tables[table_key]
    main_table = info["name"]
    temp_table = info["temp"]
    log_table = info["log"]
    required_cols = info["required_cols"]
    key_cols = info.get("key_col", required_cols[-1])  # may be str or list

    with tab:
        # Approval Dashboard
        st.markdown("## Approval Dashboard")
        try:
            ensure_session()
            logs = session.sql("SELECT * FROM " + log_table + " WHERE approved = FALSE").to_pandas()
        except Exception as e:
            st.error("Could not fetch pending logs: " + str(e))
            logs = pd.DataFrame()

        pending_count = len(logs)
        st.markdown(f"### Pending Logs for {table_key} ({pending_count})")

        if logs.empty:
            st.success("No pending approvals.")
        else:
            logs.columns = [c.lower() for c in logs.columns]
            display_cols = [c for c in logs.columns if c not in ["approved", "approved_by", "approved_at"]]
            display_df = logs[display_cols].copy().reset_index(drop=True)

            approve_key = f"approve_col_{table_key}"
            if approve_key not in st.session_state or len(st.session_state[approve_key]) != len(display_df):
                st.session_state[approve_key] = [False] * len(display_df)

            if st.button("Select All Pending for Approval", key=f"select_all_{table_key}"):
                st.session_state[approve_key] = [True] * len(display_df)

            display_df["approve"] = st.session_state[approve_key]

            column_config = {col: st.column_config.Column(disabled=True) for col in display_df.columns if col != "approve"}
            column_config["approve"] = st.column_config.CheckboxColumn("Approve", help="Tick to approve this record", width=80)

            edited_logs = st.data_editor(
                display_df,
                use_container_width=True,
                height=300,
                column_config=column_config,
                hide_index=True,
                key=f"data_editor_logs_{table_key}"
            )

            if "approve" in edited_logs.columns:
                st.session_state[approve_key] = list(edited_logs["approve"])

            # Approval handler (keeps previous coercion logic for main table writes)
            if st.button(f"Approve Selected Records for {table_key}"):
                ensure_session()
                try:
                    logs_db = session.sql("SELECT * FROM " + log_table + " WHERE approved = FALSE").to_pandas()
                except Exception as e:
                    st.error("Could not fetch logs for approval: " + str(e))
                    logs_db = pd.DataFrame()

                if logs_db.empty:
                    st.info("No pending logs found at approval time.")
                else:
                    logs_db.columns = [c.lower() for c in logs_db.columns]

                    def db_row_key(r):
                        t = r.get("table_name") if r.get("table_name") is not None else ""
                        a = r.get("action") if r.get("action") is not None else ""
                        cb = r.get("changed_by") if r.get("changed_by") is not None else ""
                        ch = r.get("changed_at")
                        try:
                            ch_iso = ch.isoformat() if hasattr(ch, "isoformat") else str(ch)
                        except Exception:
                            ch_iso = str(ch)
                        return (str(t), str(a), str(cb), str(ch_iso))

                    db_key_map = {}
                    for _, r in logs_db.iterrows():
                        key = db_row_key(r)
                        db_key_map.setdefault(key, []).append(r)

                    to_approve = edited_logs[edited_logs["approve"] == True]
                    if to_approve.empty:
                        st.warning("No rows selected for approval.")
                    else:
                        processed = 0
                        errors = []

                        # helper to build where/set clauses using main table types
                        def build_where_from_dict_with_types(d, col_types):
                            if not isinstance(d, dict) or not d:
                                return None
                            parts = []
                            for k, v in d.items():
                                col = str(k).upper()
                                # coerce based on column type
                                val_sql = coerce_value_for_column(col, v, col_types)
                                if val_sql == "NULL":
                                    parts.append(col + " IS NULL")
                                else:
                                    parts.append(col + " = " + val_sql)
                            return " AND ".join(parts) if parts else None

                        def build_set_from_dict_with_types(d, col_types):
                            if not isinstance(d, dict) or not d:
                                return None
                            parts = []
                            for k, v in d.items():
                                col = str(k).upper()
                                val_sql = coerce_value_for_column(col, v, col_types)
                                if val_sql == "NULL":
                                    parts.append(col + " = NULL")
                                else:
                                    parts.append(col + " = " + val_sql)
                            return ", ".join(parts) if parts else None

                        for _, edited_row in to_approve.iterrows():
                            table_name = edited_row.get("table_name")
                            action = edited_row.get("action")
                            changed_by = edited_row.get("changed_by")
                            changed_at = edited_row.get("changed_at")
                            try:
                                changed_at_iso = changed_at.isoformat() if hasattr(changed_at, "isoformat") else str(changed_at)
                            except Exception:
                                changed_at_iso = str(changed_at)
                            lookup_key = (str(table_name), str(action), str(changed_by), str(changed_at_iso))

                            matched = db_key_map.get(lookup_key)
                            if not matched:
                                msg = "No matching DB log found for selected row: " + str(lookup_key)
                                errors.append(msg)
                                st.warning(msg)
                                continue

                            db_row = matched.pop(0)
                            log_id = db_row.get("log_id")
                            new_value_db = db_row.get("new_value")
                            old_value_db = db_row.get("old_value")
                            table_name_db = db_row.get("table_name")
                            action_db = db_row.get("action")

                            # find mapping
                            main_info = None
                            for k, inf in main_tables.items():
                                if inf.get("name") == table_name_db:
                                    main_info = inf
                                    break
                            if not main_info:
                                msg = "No main mapping found for " + str(table_name_db) + " (log_id=" + str(log_id) + ")"
                                errors.append(msg)
                                st.error(msg)
                                continue

                            main_table_name = main_info.get("name")
                            required_cols_local = main_info.get("required_cols")

                            # fetch main table column types (for coercion)
                            main_col_types = fetch_table_column_types(main_table_name)

                            parsed_new = parse_new_value(new_value_db) if new_value_db is not None else {}
                            parsed_old = parse_new_value(old_value_db) if old_value_db is not None else {}

                            act = str(action_db).upper() if action_db is not None else "INSERT"

                            try:
                                if act == "INSERT":
                                    # Use keys from parsed_new if available; otherwise fallback to required_cols_local
                                    cols_from_new = list(parsed_new.keys()) if isinstance(parsed_new, dict) and parsed_new else required_cols_local
                                    vals_parts = []
                                    for col in cols_from_new:
                                        raw_val = parsed_new.get(col) if isinstance(parsed_new, dict) else None
                                        if raw_val is None and isinstance(parsed_new, dict):
                                            raw_val = parsed_new.get(col.lower(), parsed_new.get(col.upper(), None))
                                        val_sql = coerce_value_for_column(col, raw_val, main_col_types)
                                        vals_parts.append(val_sql)
                                    insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(cols_from_new) + ") VALUES (" + ", ".join(vals_parts) + ")"
                                    session.sql(insert_sql).collect()
                                    processed += 1

                                elif act == "UPDATE":
                                    set_clause = build_set_from_dict_with_types(parsed_new, main_col_types)
                                    where_clause = build_where_from_dict_with_types(parsed_old, main_col_types)
                                    if set_clause and where_clause:
                                        update_sql = "UPDATE " + main_table_name + " SET " + set_clause + " WHERE " + where_clause
                                        session.sql(update_sql).collect()
                                        processed += 1
                                    else:
                                        # fallback to insert
                                        cols_from_new = list(parsed_new.keys()) if isinstance(parsed_new, dict) and parsed_new else required_cols_local
                                        vals_parts = []
                                        for col in cols_from_new:
                                            raw_val = parsed_new.get(col) if isinstance(parsed_new, dict) else None
                                            if raw_val is None and isinstance(parsed_new, dict):
                                                raw_val = parsed_new.get(col.lower(), parsed_new.get(col.upper(), None))
                                            val_sql = coerce_value_for_column(col, raw_val, main_col_types)
                                            vals_parts.append(val_sql)
                                        insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(cols_from_new) + ") VALUES (" + ", ".join(vals_parts) + ")"
                                        session.sql(insert_sql).collect()
                                        processed += 1

                                elif act == "DELETE":
                                    where_clause = build_where_from_dict_with_types(parsed_old, main_col_types)
                                    if where_clause:
                                        delete_sql = "DELETE FROM " + main_table_name + " WHERE " + where_clause
                                        session.sql(delete_sql).collect()
                                        processed += 1
                                    else:
                                        where_clause2 = build_where_from_dict_with_types(parsed_new, main_col_types)
                                        if where_clause2:
                                            session.sql("DELETE FROM " + main_table_name + " WHERE " + where_clause2).collect()
                                            processed += 1
                                        else:
                                            msg = "Cannot determine WHERE clause for DELETE for log_id=" + str(log_id) + "; skipped."
                                            errors.append(msg)
                                            st.warning(msg)
                                            continue
                                else:
                                    # unknown action: insert
                                    cols_from_new = list(parsed_new.keys()) if isinstance(parsed_new, dict) and parsed_new else required_cols_local
                                    vals_parts = []
                                    for col in cols_from_new:
                                        raw_val = parsed_new.get(col) if isinstance(parsed_new, dict) else None
                                        if raw_val is None and isinstance(parsed_new, dict):
                                            raw_val = parsed_new.get(col.lower(), parsed_new.get(col.upper(), None))
                                        val_sql = coerce_value_for_column(col, raw_val, main_col_types)
                                        vals_parts.append(val_sql)
                                    insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(cols_from_new) + ") VALUES (" + ", ".join(vals_parts) + ")"
                                    session.sql(insert_sql).collect()
                                    processed += 1

                                # mark log approved
                                try:
                                    if log_id is not None:
                                        try:
                                            lid = int(log_id)
                                            sql_mark = (
                                                "UPDATE " + log_table +
                                                " SET approved = TRUE, approved_by = 'business_user', approved_at = CURRENT_TIMESTAMP "
                                                "WHERE log_id = " + str(lid) + " AND approved = FALSE"
                                            )
                                            session.sql(sql_mark).collect()
                                        except Exception:
                                            table_name_esc = str(table_name_db).replace("'", "''")
                                            changed_at_str = str(db_row.get('changed_at')).replace("'", "''")
                                            sql_mark = (
                                                "UPDATE " + log_table +
                                                " SET approved = TRUE, approved_by = 'business_user', approved_at = CURRENT_TIMESTAMP "
                                                "WHERE table_name = '" + table_name_esc + "' AND changed_at = '" + changed_at_str + "'"
                                            )
                                            session.sql(sql_mark).collect()
                                    else:
                                        table_name_esc = str(table_name_db).replace("'", "''")
                                        changed_at_str = str(db_row.get('changed_at')).replace("'", "''")
                                        sql_mark = (
                                            "UPDATE " + log_table +
                                            " SET approved = TRUE, approved_by = 'business_user', approved_at = CURRENT_TIMESTAMP "
                                            "WHERE table_name = '" + table_name_esc + "' AND changed_at = '" + changed_at_str + "'"
                                        )
                                        session.sql(sql_mark).collect()
                                except Exception as e:
                                    errors.append("Could not mark log approved for log_id=" + str(log_id) + ": " + str(e))

                            except Exception as e:
                                errors.append("Error processing log_id=" + str(log_id) + ": " + str(e))
                                st.error("Error processing log_id=" + str(log_id) + ": " + str(e))
                                continue

                        st.success("Approval run complete. Processed " + str(processed) + " item(s).")
                        if errors:
                            st.warning("Some items had issues; check messages above.")

                        # refresh UI
                        try:
                            if hasattr(st, "experimental_rerun"):
                                st.experimental_rerun()
                            elif hasattr(st, "rerun"):
                                st.rerun()
                            else:
                                import streamlit.components.v1 as components
                                components.html("<script>window.location.reload()</script>", height=0)
                        except Exception:
                            import streamlit.components.v1 as components
                            components.html("<script>window.location.reload()</script>", height=0)

        # Main Table Editable UI
        st.markdown("---")
        st.subheader("Main Table: " + main_table)
        ensure_session()
        main_df = fetch_main_table_sorted(main_table)

        if main_df.empty:
            st.info("Main table empty or could not be fetched.")
        else:
            st.markdown("**Tip:** Toggle edit mode to change cells. Click **Send Edits to Approval** to push edits to TEMP & LOG (main table unchanged until approval).")

            edit_key = f"main_edit_enabled_{table_key}"
            if edit_key not in st.session_state:
                st.session_state[edit_key] = False

            toggle_label = "Disable Editing" if st.session_state[edit_key] else "Enable Editing"
            if st.button(toggle_label, key=f"btn_edit_{table_key}"):
                st.session_state[edit_key] = not st.session_state[edit_key]

            if st.session_state[edit_key]:
                st.success("Edit mode enabled — you can edit cells. Click the button again to disable editing.")
            else:
                st.info("Edit mode disabled — table is read-only. Click 'Enable Editing' to allow edits.")

            if AGGRID_AVAILABLE:
                gb = GridOptionsBuilder.from_dataframe(main_df)
                gb.configure_default_column(editable=bool(st.session_state[edit_key]), resizable=True, filter=True, sortable=True)
                gb.configure_grid_options(domLayout='normal')
                grid_opts = gb.build()
                grid_resp = AgGrid(
                    main_df,
                    gridOptions=grid_opts,
                    data_return_mode=DataReturnMode.FILTERED_AND_SORTED,
                    update_mode=GridUpdateMode.MANUAL,
                    fit_columns_on_grid_load=True,
                    enable_enterprise_modules=False,
                    allow_unsafe_jscode=False,
                    theme="alpine",
                    key=f"aggrid_main_{table_key}"
                )
                edited_data = pd.DataFrame(grid_resp["data"])
            else:
                column_config = {}
                if not st.session_state[edit_key]:
                    for c in main_df.columns:
                        column_config[c] = st.column_config.Column(disabled=True)
                    edited_data = st.data_editor(
                        main_df,
                        use_container_width=True,
                        num_rows="dynamic",
                        column_config=column_config,
                        key=f"data_editor_main_{table_key}"
                    )
                else:
                    edited_data = st.data_editor(
                        main_df,
                        use_container_width=True,
                        num_rows="dynamic",
                        key=f"data_editor_main_{table_key}"
                    )

            # -------------------------
            # SIMPLE DETERMINISTIC "Send Edits to Approval" handler
            # (replaces the previous complex pairing logic)
            # -------------------------
            if st.button("Send Edits to Approval", key=f"send_edits_{table_key}"):
                try:
                    ensure_session()

                    # original and edited DataFrames
                    orig = main_df.copy()
                    new = edited_data.copy()

                    # build index maps keyed by stable key (supports composite key)
                    orig_index = {}
                    new_index = {}
                    if not orig.empty:
                        for _, r in orig.iterrows():
                            k = get_row_key(r, key_cols)
                            orig_index[k] = r
                    if not new.empty:
                        for _, r in new.iterrows():
                            k = get_row_key(r, key_cols)
                            new_index[k] = r

                    # classify keys
                    orig_keys = set(orig_index.keys())
                    new_keys = set(new_index.keys())

                    inserted_keys = new_keys - orig_keys           # new rows (INSERT)
                    deleted_keys  = orig_keys - new_keys           # removed rows (DELETE)
                    possible_updates = orig_keys & new_keys        # same key -> maybe UPDATE

                    processed = 0
                    errors = []

                    # Helper to build SQL insert into TEMP using required_cols (keeps DESCRIPTION)
                    def insert_row_into_temp_from_series(series_row):
                        cols_sql = ", ".join(required_cols)
                        vals = []
                        for c in required_cols:
                            v = get_series_value(series_row, c)
                            if v is None or v == "":
                                vals.append("NULL")
                            else:
                                # escape single quotes safely
                                sval = str(v).replace("'", "''")
                                vals.append("'" + normalize_string(sval) + "'")
                        vals_sql = ", ".join(vals)
                        insert_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                        session.sql(insert_sql).collect()

                    # Process INSERTs (new rows)
                    for k in inserted_keys:
                        try:
                            new_row = new_index[k]
                            # insert into temp
                            insert_row_into_temp_from_series(new_row)
                            # build new dict for log
                            new_dict = {c: get_series_value(new_row, c) for c in required_cols}
                            log_change(main_table, "INSERT", None, new_dict)
                            processed += 1
                        except Exception as e:
                            errors.append(f"Insert key={k} failed: {e}")

                    # Process DELETEs (rows removed from main by user)
                    for k in deleted_keys:
                        try:
                            old_row = orig_index[k]
                            # insert old row into temp so approval can delete from main after approval
                            insert_row_into_temp_from_series(old_row)
                            old_dict = {c: get_series_value(old_row, c) for c in required_cols}
                            log_change(main_table, "DELETE", old_dict, None)
                            processed += 1
                        except Exception as e:
                            errors.append(f"Delete key={k} failed: {e}")

                    # Process UPDATES (same key but values changed)
                    for k in possible_updates:
                        try:
                            old_row = orig_index[k]
                            new_row = new_index[k]
                            # detect if any value changed (normalize strings)
                            changed = False
                            for c in required_cols:
                                o_val = get_series_value(old_row, c)
                                n_val = get_series_value(new_row, c)
                                # normalize string comparison
                                if isinstance(o_val, str):
                                    o_val_cmp = normalize_string(o_val)
                                else:
                                    o_val_cmp = o_val
                                if isinstance(n_val, str):
                                    n_val_cmp = normalize_string(n_val)
                                else:
                                    n_val_cmp = n_val
                                if o_val_cmp != n_val_cmp:
                                    changed = True
                                    break
                            if not changed:
                                continue  # no-op

                            # insert new_row into temp (so approver can see new data)
                            insert_row_into_temp_from_series(new_row)

                            # prepare dicts for log (old/new)
                            old_dict = {c: get_series_value(old_row, c) for c in required_cols}
                            new_dict = {c: get_series_value(new_row, c) for c in required_cols}
                            log_change(main_table, "UPDATE", old_dict, new_dict)
                            processed += 1
                        except Exception as e:
                            errors.append(f"Update key={k} failed: {e}")

                    st.success(f"Sent edits to TEMP and logged for approval. Processed: {processed}")
                    if errors:
                        for er in errors:
                            st.warning(er)

                    # refresh the page so pending count and main display reflect latest DB state
                    try:
                        if hasattr(st, "experimental_rerun"):
                            st.experimental_rerun()
                        elif hasattr(st, "rerun"):
                            st.rerun()
                        else:
                            import streamlit.components.v1 as components
                            components.html("<script>window.location.reload()</script>", height=0)
                    except Exception:
                        pass

                except Exception as e:
                    st.error("Error processing edits for approval: " + str(e))

            # -------------------------
            # Upload / Manual Insert / Temp CRUD
            # -------------------------
            st.markdown("---")
            st.markdown("### Upload Excel or CSV (Inserts into TEMP Table)")

            # -------------------------
            # Robust type-aware upload block (schema introspection + coercion)
            # -------------------------
            uploaded_file = st.file_uploader("Upload for " + table_key, type=["xlsx", "csv"])
            if uploaded_file:
                ensure_session()
                excel_df = read_uploaded_file(uploaded_file)
                if excel_df is not None:
                    # normalize incoming column names to upper-case (matching Snowflake)
                    excel_df.columns = [col.strip().upper() for col in excel_df.columns]
                    cols_in_file = list(excel_df.columns)
                    st.dataframe(excel_df.head())

                    # fetch temp table metadata if possible (DB.SCHEMA.TABLE)
                    table_col_types = {}
                    try:
                        parts = temp_table.split(".")
                        if len(parts) == 3:
                            db_name, schema_name, tbl_name = parts
                            q = (
                                "SELECT column_name, data_type FROM "
                                f"{db_name}.information_schema.columns "
                                f"WHERE table_name = '{tbl_name}' AND table_schema = '{schema_name}'"
                            )
                            cols_meta = session.sql(q).to_pandas()
                            table_col_types = {r['COLUMN_NAME'].upper(): str(r['DATA_TYPE']).upper() for _, r in cols_meta.iterrows()}
                        else:
                            st.warning("Temp table name not in DB.SCHEMA.TABLE format; skipping schema introspection.")
                    except Exception as e:
                        st.warning("Could not fetch temp table metadata; proceeding with file columns only. Error: " + str(e))
                        table_col_types = {}

                    # decide which columns to insert
                    if table_col_types:
                        cols_to_insert = [c for c in cols_in_file if c in table_col_types]
                        if not cols_to_insert:
                            st.error("None of the uploaded columns match columns in the TEMP table. Aborting upload.")
                            cols_to_insert = []
                    else:
                        cols_to_insert = cols_in_file

                    if cols_to_insert:
                        if st.button("Upload to TEMP for " + table_key):
                            inserted = 0
                            for _, row in excel_df.iterrows():
                                vals_list = []
                                for col in cols_to_insert:
                                    raw_v = row.get(col, "")
                                    if isinstance(raw_v, str):
                                        raw_v = normalize_string(raw_v)
                                    try:
                                        if pd.isna(raw_v):
                                            raw_v = None
                                    except Exception:
                                        pass
                                    col_type = table_col_types.get(col, "")
                                    try:
                                        if col_type and ("TIMESTAMP" in col_type or "DATE" in col_type or "TIME" in col_type):
                                            dt = pd.to_datetime(raw_v, errors="coerce", dayfirst=False)
                                            if pd.isna(dt):
                                                vals_list.append("NULL")
                                            else:
                                                val_str = dt.strftime("%Y-%m-%d %H:%M:%S")
                                                vals_list.append(sql_literal(val_str))
                                        elif col_type and any(x in col_type for x in ("NUMBER", "INT", "DECIMAL", "NUMERIC", "FLOAT", "DOUBLE")):
                                            try:
                                                if raw_v is None or raw_v == "":
                                                    vals_list.append("NULL")
                                                else:
                                                    num = float(raw_v)
                                                    vals_list.append(str(int(num)) if num.is_integer() else str(num))
                                            except Exception:
                                                vals_list.append("NULL")
                                        else:
                                            if raw_v is None or raw_v == "":
                                                vals_list.append("NULL")
                                            else:
                                                sval = str(raw_v).replace("'", "''")
                                                vals_list.append("'" + sval + "'")
                                    except Exception:
                                        vals_list.append("NULL")

                                cols_sql = ", ".join(cols_to_insert)
                                vals_sql = ", ".join(vals_list)
                                insert_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                                try:
                                    session.sql(insert_sql).collect()
                                except Exception as e:
                                    st.error("Insert to TEMP failed: " + str(e))
                                    continue

                                row_dict = {c: clean_for_json(normalize_string(row.get(c)) if isinstance(row.get(c), str) else row.get(c)) for c in cols_to_insert}
                                try:
                                    log_change(main_table, "INSERT", None, row_dict)
                                except Exception as e:
                                    st.warning("Failed to write log for inserted row: " + str(e))
                                inserted += 1

                            st.success(str(inserted) + " rows uploaded to TEMP table and logged.")

            # Manual insert
            st.subheader("Manual Insert into TEMP Table")
            with st.form("insert_form_" + table_key):
                inputs = {col: st.text_input(col) for col in required_cols}
                submit = st.form_submit_button("Insert Record")
                if submit:
                    cols_sql = ", ".join(inputs.keys())
                    cleaned_vals = []
                    for v in inputs.values():
                        if isinstance(v, str):
                            v = normalize_string(v)
                        if v == "" or v is None:
                            cleaned_vals.append("NULL")
                        else:
                            cleaned_vals.append("'" + str(v).replace("'", "''") + "'")
                    vals_sql = ", ".join(cleaned_vals)
                    insert_sql = "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                    try:
                        session.sql(insert_sql).collect()
                        log_change(main_table, "INSERT", None, {k: normalize_string(v) if isinstance(v, str) else v for k, v in inputs.items()})
                        st.success("Record inserted into TEMP and logged.")
                    except Exception as e:
                        st.error("Insert to TEMP failed: " + str(e))

            # Update in TEMP
            st.subheader("Update Record (in TEMP Table)")
            with st.form("update_form_" + table_key):
                key_inputs = {}
                if isinstance(key_cols, (list, tuple)):
                    cols_ui = st.columns(len(key_cols))
                    for i, kc in enumerate(key_cols):
                        with cols_ui[i]:
                            val = st.text_input(kc + " value")
                            key_inputs[kc] = val

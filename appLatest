def ensure_session():
    """Ensure a global Snowflake session is available."""
    global session
    try:
        if session is None:
            session = get_active_session()
        session.sql("SELECT 1").collect()
        return True
    except Exception as e:
        try:
            session = get_active_session()
            session.sql("SELECT 1").collect()
            return True
        except Exception as e2:
            st.error("Database session expired or unavailable. Please refresh the app (F5).")
            with st.expander("Technical details"):
                st.text(str(e2))
            st.stop()
            return False


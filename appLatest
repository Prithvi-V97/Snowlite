                                    else:
                                        new_row[c] = None

                            # Insert the new_row into TEMP (always; updates are proposed changes pending approval)
                            cols_sql = ", ".join(required_cols)
                            vals_sql_parts = []
                            for c in required_cols:
                                v = new_row.get(c)
                                if v is None or v == "":
                                    vals_sql_parts.append("NULL")
                                else:
                                    vals_sql_parts.append("'" + str(v).replace("'", "''") + "'")
                            vals_sql = ", ".join(vals_sql_parts)
                            session.sql("INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")").collect()

                            # Log the change:
                            # - If we had an old_source (MAIN or TEMP) -> log as UPDATE with that old_dict and new_row
                            # - Else -> log as INSERT (old_value = None)
                            if old_source is not None:
                                # defensive plain dicts already constructed; log_change will deepcopy & serialize
                                log_change(main_table, "UPDATE", old_dict, new_row)
                                st.success("Proposed UPDATE recorded in TEMP and logged for approval (old value captured from MAIN/TEMP).")
                            else:
                                log_change(main_table, "INSERT", None, new_row)
                                st.success("Proposed INSERT recorded in TEMP and logged for approval.")

                        except Exception as e:
                            st.error("Update failed: " + str(e))


        # Delete in TEMP
        st.subheader("Delete Record (from TEMP Table)")
        with st.form(f"delete_form_{table_key}"):
            del_key_inputs = {}
            if isinstance(key_cols, (list, tuple)):
                cols_ui = st.columns(len(key_cols))
                for i, kc in enumerate(key_cols):
                    with cols_ui[i]:
                        del_key_inputs[kc] = st.text_input(kc + " (key value to delete)")
            else:
                del_key_inputs[key_cols] = st.text_input(f"{key_cols} to Delete")

            confirm = st.checkbox("Confirm Delete")
            submit_del = st.form_submit_button("Delete Record")
            if submit_del:
                if not confirm:
                    st.warning("Please confirm delete before proceeding.")
                else:
                    # --- 1) Validate all key inputs ---
                    missing_keys = []
                    if isinstance(key_cols, (list, tuple)):
                        for kc in key_cols:
                            v = del_key_inputs.get(kc)
                            if v is None or (isinstance(v, str) and v.strip() == ""):
                                missing_keys.append(kc)
                    else:
                        v = del_key_inputs.get(key_cols)
                        if v is None or (isinstance(v, str) and v.strip() == ""):
                            missing_keys.append(key_cols)

                    if missing_keys:
                        st.error("Please provide all key column values before deleting: " + ", ".join(missing_keys))
                    else:
                        # Build normalized, case-insensitive WHERE clause
                        where_clause = build_where_from_key_inputs(key_cols, del_key_inputs)

                        if not where_clause:
                            st.error("Could not build WHERE clause. Please check key values.")
                        else:
                            try:
                                # ----------------------------------------------------
                                # --- 2) Try DELETE from TEMP first (Option B step 1)
                                # ----------------------------------------------------
                                sel_temp_sql = "SELECT * FROM " + temp_table + " WHERE " + where_clause + " LIMIT 1"
                                try:
                                    temp_df = session.sql(sel_temp_sql).to_pandas()
                                except Exception:
                                    # Fallback for Snowflake if LIMIT issues
                                    temp_df = session.sql("SELECT * FROM " + temp_table + " WHERE " + where_clause).to_pandas()

                                if temp_df is not None and not temp_df.empty:
                                    # Row exists in TEMP → capture old row
                                    old_row_dict = temp_df.iloc[0].to_dict()
                                    old_row_norm = {
                                        str(k): (normalize_string(v) if isinstance(v, str) else v)
                                        for k, v in old_row_dict.items()
                                    }
                                    old_row_clean = clean_for_json(old_row_norm)

                                    # Delete from TEMP
                                    session.sql("DELETE FROM " + temp_table + " WHERE " + where_clause).collect()

                                    # Log DELETE
                                    log_change(main_table, "DELETE", old_row_clean, None)
                                    st.success("Deleted row from TEMP and logged DELETE for approval.")

                                else:
                                    # ----------------------------------------------------
                                    # --- 3) Row not in TEMP → fetch from MAIN (Option B)
                                    # ----------------------------------------------------
                                    sel_main_sql = "SELECT * FROM " + main_table + " WHERE " + where_clause + " LIMIT 1"
                                    try:
                                        main_df_sel = session.sql(sel_main_sql).to_pandas()
                                    except Exception:
                                        main_df_sel = session.sql("SELECT * FROM " + main_table + " WHERE " 
                                        + where_clause).to_pandas()

                                    if main_df_sel is not None and not main_df_sel.empty:
                                        # --- Found in MAIN → copy to TEMP + log DELETE ---
                                        main_row = main_df_sel.iloc[0].to_dict()
                                        main_row_norm = {
                                            str(k): (normalize_string(v) if isinstance(v, str) else v)
                                            for k, v in main_row.items()
                                        }
                                        old_row_clean = clean_for_json(main_row_norm)

                                        # Build TEMP row values from MAIN row (full copy)
                                        new_temp_row = {}
                                        for c in required_cols:
                                            v = main_row.get(c)
                                            if isinstance(v, str):
                                                new_temp_row[c] = normalize_string(v)
                                            else:
                                                new_temp_row[c] = v

                                        # Insert the copied MAIN row into TEMP
                                        cols_sql = ", ".join(required_cols)
                                        vals_sql_parts = []
                                        for c in required_cols:
                                            v = new_temp_row.get(c)
                                            if v is None or v == "":
                                                vals_sql_parts.append("NULL")
                                            else:
                                                vals_sql_parts.append("'" + str(v).replace("'", "''") + "'")
                                        vals_sql = ", ".join(vals_sql_parts)

                                        session.sql(
                                            "INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")"
                                        ).collect()

                                        # Log DELETE
                                        log_change(main_table, "DELETE", old_row_clean, None)

                                        st.success(
                                            "Row not found in TEMP. Fetched from MAIN, inserted into TEMP, and logged DELETE for approval."
                                        )

                                    else:
                                        # ----------------------------------------------------
                                        # --- 4) Not in MAIN or TEMP → can't delete
                                        # ----------------------------------------------------
                                        st.error(
                                            "No matching record found in MAIN or TEMP for the provided key values. "
                                            "Delete request aborted."
                                        )

                            except Exception as e:
                                st.error("Delete failed: " + str(e))


                where_clause = build_where_from_key_inputs(key_cols, key_inputs)
                if not where_clause:
                    st.error("Could not build WHERE clause for update; provide key values.")
                else:
                    try:
                        escaped_new_value = "" if new_value is None else str(normalize_string(new_value)).replace("'", "''")
                        # capture old before update
                        try:
                            old_df = session.sql("SELECT " + upd_col + " FROM " + temp_table + " WHERE " + where_clause).to_pandas()
                            old_val = old_df.iloc[0, 0] if not old_df.empty else None
                        except Exception:
                            old_val = None
                        session.sql("UPDATE " + temp_table + " SET " + upd_col + " = '" + escaped_new_value + "' WHERE " + where_clause).collect()
                        log_change(main_table, "UPDATE", {upd_col: old_val}, {upd_col: new_value})
                        st.success("Record updated in TEMP and logged.")
                    except Exception as e:
                        st.error("Update failed: " + str(e))

        # Delete in TEMP
        st.subheader("Delete Record (from TEMP Table)")
        with st.form(f"delete_form_{table_key}"):
            del_key_inputs = {}
            if isinstance(key_cols, (list, tuple)):
                cols_ui = st.columns(len(key_cols))
                for i, kc in enumerate(key_cols):
                    with cols_ui[i]:
                        del_key_inputs[kc] = st.text_input(kc + " (key value to delete)")
            else:
                del_key_inputs[key_cols] = st.text_input(f"{key_cols} to Delete")

            confirm = st.checkbox("Confirm Delete")
            submit_del = st.form_submit_button("Delete Record")
            if submit_del:
                if not confirm:
                    st.warning("Please confirm delete before proceeding.")
                else:
                    where_clause = build_where_from_key_inputs(key_cols, del_key_inputs)
                    if not where_clause:
                        st.error("Could not build WHERE clause for delete; provide key values.")
                    else:
                        try:
                            old_val = None
                            try:
                                old_df = session.sql("SELECT * FROM " + temp_table + " WHERE " + where_clause).to_pandas()
                                old_val = old_df.to_dict(orient="records")[0] if not old_df.empty else None
                            except Exception:
                                old_val = None
                            session.sql("DELETE FROM " + temp_table + " WHERE " + where_clause).collect()
                            log_change(main_table, "DELETE", old_val, None)
                            st.success("Record deleted from TEMP and logged.")
                        except Exception as e:
                            st.error("Delete failed: " + str(e))



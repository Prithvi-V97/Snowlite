def ensure_session():
    """
    Ensure the global `session` is alive. Try a lightweight query; if it fails attempt to re-create
    with get_active_session(). If unsuccessful, show message and stop the Streamlit run.
    """
    global session
    try:
        if session is None:
            session = get_active_session()
        session.sql("SELECT 1").collect()
        return True
    except Exception as e:
        # try one more time
        try:
            session = get_active_session()
            session.sql("SELECT 1").collect()
            return True
        except Exception as e2:
            st.error("Database session expired or unavailable. Please refresh the app (F5) to re-establish connection.")
            with st.expander("Technical error details (expand if you need them)"):
                st.text(str(e2))
            st.stop()
            return False


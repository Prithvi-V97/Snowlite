                        except Exception as e:
                            st.error("Update in TEMP failed: " + str(e))

            # Delete in TEMP
            st.subheader("Delete Record (from TEMP Table)")
            with st.form("delete_form_" + table_key):
                del_key_inputs = {}
                if isinstance(key_cols, (list, tuple)):
                    cols_ui = st.columns(len(key_cols))
                    for i, kc in enumerate(key_cols):
                        with cols_ui[i]:
                            val = st.text_input(kc + " value (for delete)")
                            del_key_inputs[kc] = val
                else:
                    del_key_inputs[key_cols] = st.text_input(f"{key_cols} to Delete")

                confirm = st.checkbox("Confirm Delete")
                submit_del = st.form_submit_button("Delete Record")
                if submit_del and confirm:
                    where_clause = build_where_from_key_inputs(key_cols, del_key_inputs)
                    old_val = None
                    if where_clause:
                        try:
                            ensure_session()
                            old_val_df = session.sql("SELECT * FROM " + temp_table + " WHERE " + where_clause).to_pandas()
                            old_val = old_val_df.to_dict(orient="records")[0] if not old_val_df.empty else None
                        except Exception:
                            old_val = None
                    if not where_clause:
                        st.error("Could not build WHERE clause for delete - please provide key values.")
                    else:
                        delete_sql = "DELETE FROM " + temp_table + " WHERE " + where_clause
                        try:
                            session.sql(delete_sql).collect()
                            log_change(main_table, "DELETE", old_val, None)
                            st.success("Record deleted from TEMP and logged.")
                        except Exception as e:
                            st.error("Delete in TEMP failed: " + str(e))
                elif submit_del:
                    st.warning("Please confirm delete before proceeding.")


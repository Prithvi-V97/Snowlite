                                    else:
                                        o_cmp = o_val
                                    if isinstance(n_val, str):
                                        n_cmp = normalize_string(n_val)
                                    else:
                                        n_cmp = n_val
                                    if o_cmp != n_cmp:
                                        changed = True
                                        break
                            if not changed:

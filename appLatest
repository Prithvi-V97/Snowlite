                        return df2

                    orig_norm = normalize_key_columns_in_df(orig, key_cols)
                    new_norm = normalize_key_columns_in_df(new, key_cols)

                    # build index maps keyed by stable key
                    orig_index = {}
                    new_index = {}
                    orig_keys = []

                    if not orig_norm.empty:
                        # Build orig_index and list of orig_keys (ordered by row position)
                        for _, r in orig_norm.iterrows():

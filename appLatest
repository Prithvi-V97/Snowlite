                    num_rows="dynamic",
                    column_config=column_config,
                    key=f"data_editor_main_{table_key}",
                )

            if edited_data is not None and not edited_data.empty:
                edited_data = edited_data.loc[:, ~edited_data.columns.duplicated()]

            # --- Send Edits to Approval (detect diffs and send only changed rows) ---
            if st.button("Send Edits to Approval", key=f"send_edits_{table_key}"):
                try:
                    ensure_session()
                    orig = main_df.copy().reset_index(drop=True)
                    new = edited_data.copy().reset_index(drop=True)

                    # Normalize key columns in both orig and new before building indices so keys match robustly
                    def normalize_key_columns_in_df(df, key_cols_local):
                        df2 = df.copy()
                        if isinstance(key_cols_local, (list, tuple)):
                            for kc in key_cols_local:
                                if kc in df2.columns:
                                    df2[kc] = df2[kc].apply(lambda x: normalize_string(x) if isinstance(x, str) else x)
                        else:
                            if key_cols_local in df2.columns:
                                df2[key_cols_local] = df2[key_cols_local].apply(lambda x: normalize_string(x) if isinstance(x, str) else x)
                        return df2

                    orig_norm = normalize_key_columns_in_df(orig, key_cols)
                    new_norm = normalize_key_columns_in_df(new, key_cols)

                    # build index maps keyed by stable key
                    orig_index = {}
                    new_index = {}
                    if not orig_norm.empty:
                        for _, r in orig_norm.iterrows():
                            k = get_row_key(r, key_cols)
                            orig_index[k] = r
                    if not new_norm.empty:
                        for _, r in new_norm.iterrows():
                            k = get_row_key(r, key_cols)
                            new_index[k] = r

                    processed = 0
                    errors = []

                    def insert_row_into_temp_from_series(series_row):
                        cols_sql = ", ".join(required_cols)
                        vals = []
                        for c in required_cols:
                            v = get_series_value(series_row, c)
                            if v is None or v == "":
                                vals.append("NULL")
                            else:
                                sval = str(v).replace("'", "''")
                                vals.append("'" + normalize_string(sval) + "'")
                        vals_sql = ", ".join(vals)
                        session.sql("INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")").collect()

                    # iterate over new rows and compare to orig, send changed rows
                    for k, new_row in new_index.items():
                        try:
                            old_row = orig_index.get(k)
                            if old_row is None:
                                changed = True
                            else:
                                changed = False
                                for c in required_cols:
                                    o_val = get_series_value(old_row, c)
                                    n_val = get_series_value(new_row, c)
                                    if isinstance(o_val, str):
                                        o_cmp = normalize_string(o_val)
                                    else:
                                        o_cmp = o_val
                                    if isinstance(n_val, str):
                                        n_cmp = normalize_string(n_val)
                                    else:
                                        n_cmp = n_val
                                    if o_cmp != n_cmp:
                                        changed = True
                                        break
                            if not changed:
                                continue

                            # ---------------------------
                            # NEW: Build authoritative old_dict by querying MAIN table first
                            # then fallback to in-memory old_row if DB fetch fails or returns no row
                            # ---------------------------
                            old_dict = {c: None for c in required_cols}
                            try:
                                key_inputs = {}
                                if isinstance(key_cols, (list, tuple)):
                                    for kc in key_cols:
                                        key_inputs[kc] = get_series_value(old_row, kc) if old_row is not None else get_series_value(new_row, kc)
                                else:
                                    key_inputs[key_cols] = get_series_value(old_row, key_cols) if old_row is not None else get_series_value(new_row, key_cols)

                                where_clause = build_where_from_key_inputs(key_cols, key_inputs)

                                if where_clause:
                                    sel_sql = f"SELECT {', '.join(required_cols)} FROM {main_table} WHERE {where_clause} LIMIT 1"
                                    try:
                                        fetched_df = session.sql(sel_sql).to_pandas()
                                        if not fetched_df.empty:
                                            fetched_row = fetched_df.iloc[0].to_dict()
                                            old_dict = {
                                                c: normalize_string(fetched_row.get(c)) if isinstance(fetched_row.get(c), str)
                                                else clean_for_json(fetched_row.get(c))
                                                for c in required_cols
                                            }
                                    except Exception:
                                        # DB fetch failed — we'll fallback later
                                        pass

                                # Fallback to in-memory old_row if DB gave nothing
                                if all(old_dict[c] is None for c in required_cols) and old_row is not None:
                                    old_dict = {c: get_series_value(old_row, c) for c in required_cols}
                            except Exception:
                                if old_row is not None:
                                    old_dict = {c: get_series_value(old_row, c) for c in required_cols}
                                else:
                                    old_dict = {c: None for c in required_cols}

                            # Build new_dict from the edited row (always available)
                            new_dict = {c: get_series_value(new_row, c) for c in required_cols}

                            # Build cleaned_new_json for duplicate guard check
                            cleaned_new_json = json.dumps(clean_for_json(new_dict))

                            # Check duplicate pending log guard
                            try:
                                table_name_esc = str(main_table).replace("'", "''")
                                check_sql = (
                                    "SELECT COUNT(1) AS CNT FROM " + log_table +
                                    " WHERE table_name = '" + table_name_esc + "'" +
                                    " AND approved = FALSE" +
                                    " AND new_value = $$ " + cleaned_new_json + " $$"
                                )
                                cnt_df = session.sql(check_sql).to_pandas()
                                existing_cnt = int(cnt_df.iloc[0, 0]) if not cnt_df.empty else 0
                            except Exception:
                                existing_cnt = 0

                            if existing_cnt > 0:
                                errors.append(f"Skipped duplicate pending log for key={k}")
                                continue

                            # Insert changed row into TEMP and log as UPDATE
                            insert_row_into_temp_from_series(new_row)
                            log_change(main_table, "UPDATE", old_dict, new_dict)
                            processed += 1

                        except Exception as e:
                            errors.append(f"Processing key={k} failed: {e}")

                    st.success(f"Sent changed rows to TEMP and logged for approval. Processed: {processed}")
                    if errors:
                        for er in errors:
                            st.warning(er)

                    # refresh UI
                    try:
                        if hasattr(st, "experimental_rerun"):
                            st.experimental_rerun()
                        elif hasattr(st, "rerun"):
                            st.rerun()
                        else:
                            import streamlit.components.v1 as components
                            components.html("<script>window.location.reload()</script>", height=0)
                    except Exception:
                        pass

                except Exception as e:
                    st.error("Error processing edits for approval: " + str(e))

        # Upload / Manual Insert / Temp CRUD
        st.markdown("---")
        st.markdown("### Upload Excel or CSV (Inserts into TEMP Table)")
        uploaded_file = st.file_uploader(f"Upload for {table_key}", type=["xlsx", "csv"], key=f"uploader_{table_key}")
        if uploaded_file:
            ensure_session()
            excel_df = read_uploaded_file(uploaded_file)
            if excel_df is not None:
                excel_df.columns = [col.strip().upper() for col in excel_df.columns]
                st.dataframe(excel_df.head())

                # get temp table column types
                table_col_types = {}
                try:

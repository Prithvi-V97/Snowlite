                                if isinstance(raw, str):
                                    raw = normalize_string(raw)
                                try:
                                    if pd.isna(raw):
                                        raw = None
                                except Exception:
                                    pass
                                dtype = table_col_types.get(col, "")
                                try:
                                    if dtype and ("TIMESTAMP" in dtype or "DATE" in dtype or "TIME" in dtype):
                                        dt = pd.to_datetime(raw, errors="coerce", dayfirst=False)
                                        if pd.isna(dt):
                                            vals.append("NULL")
                                        else:
                                            vals.append(sql_literal(dt.strftime("%Y-%m-%d %H:%M:%S")))
                                    elif dtype and any(x in dtype for x in ("NUMBER", "INT", "DECIMAL", "NUMERIC", "FLOAT", "DOUBLE")):
                                        if raw is None or raw == "":
                                            vals.append("NULL")
                                        else:
                                            try:
                                                num = float(raw)
                                                vals.append(str(int(num)) if num.is_integer() else str(num))
                                            except Exception:
                                                vals.append("NULL")
                                    else:
                                        if raw is None or raw == "":
                                            vals.append("NULL")
                                        else:
                                            vals.append("'" + str(raw).replace("'", "''") + "'")
                                except Exception:
                                    vals.append("NULL")
                            cols_sql = ", ".join(cols_to_insert)
                            vals_sql = ", ".join(vals)
                            try:
                                session.sql("INSERT INTO " + temp_table + " (" + cols_sql + ") VALUES (" + vals_sql + ")").collect()
                                row_dict = {c: clean_for_json(normalize_string(row.get(c)) if isinstance(row.get(c), str) else row.get(c)) for c in cols_to_insert}
                                log_change(main_table, "INSERT", None, row_dict)
                                inserted += 1
                            except Exception as e:
                                st.warning("Insert to TEMP failed for a row: " + str(e))
                                continue
                        st.success(str(inserted) + " rows uploaded to TEMP and logged.")

        # Manual Insert into TEMP
        st.subheader("Manual Insert into TEMP Table")
        with st.form(f"insert_form_{table_key}"):
            inputs = {col: st.text_input(col) for col in required_cols}
            submit = st.form_submit_button("Insert Record")
            if submit:
                cols_sql = ", ".join(inputs.keys())

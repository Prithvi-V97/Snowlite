                return ast.literal_eval(s)
            except Exception:
                return {}

# --------------------------------------
# Table UI
# --------------------------------------
def render_table_ui(tab, key):
    info = main_tables[key]
    main_table = info["name"]
    temp_table = info["temp"]
    required_cols = info["required_cols"]

    with tab:
        st.subheader(f"Main Table: {main_table}")
        try:
            df_main = session.table(main_table).to_pandas()
            st.dataframe(df_main)
        except Exception:
            st.info("Main table empty or cannot be fetched.")

        key_col = required_cols[-1]

        # ---------- Upload ----------
        st.markdown("### Upload Excel/CSV to TEMP")
        uploaded = st.file_uploader(f"Upload for {key}", type=["xlsx", "csv"])
        if uploaded:
            df_u = read_uploaded_file(uploaded)
            if df_u is not None:
                df_u.columns = [c.strip().upper() for c in df_u.columns]
                st.dataframe(df_u.head())
                if all(c in df_u.columns for c in required_cols):
                    if st.button(f"Upload to TEMP for {key}"):
                        for _, r in df_u.iterrows():
                            vals = []
                            for c in required_cols:
                                v = r.get(c)
                                if isinstance(v, str):
                                    v = normalize_string(v)
                                try:
                                    if pd.isna(v):
                                        v = None
                                except Exception:
                                    pass
                                if v in [None, ""]:
                                    vals.append("NULL")
                                else:
                                    vals.append("'" + str(v).replace("'", "''") + "'")
                            sql = "INSERT INTO " + temp_table + " (" + ", ".join(required_cols) + ") VALUES (" + ", ".join(vals) + ")"
                            session.sql(sql).collect()
                            log_change(main_table, "INSERT", None, r.to_dict())
                        st.success("Uploaded to TEMP and logged.")
                else:
                    st.error("Missing required columns: " + str(required_cols))

        # ---------- Manual Insert ----------
        st.subheader("Manual Insert into TEMP")
        with st.form(f"manual_insert_{key}"):
            inputs = {c: st.text_input(c) for c in required_cols}
            submit = st.form_submit_button("Insert")
            if submit:
                vals = []
                for v in inputs.values():
                    v = normalize_string(v)
                    if v in [None, ""]:
                        vals.append("NULL")
                    else:
                        vals.append("'" + str(v).replace("'", "''") + "'")
                sql = "INSERT INTO " + temp_table + " (" + ", ".join(required_cols) + ") VALUES (" + ", ".join(vals) + ")"
                session.sql(sql).collect()
                log_change(main_table, "INSERT", None, inputs)
                st.success("Inserted into TEMP and logged.")

        # ---------- Update Record in TEMP ----------
        st.subheader("Update Record in TEMP Table")
        with st.form(f"update_{key}"):
            upd_key = st.text_input(key_col + " to Update")
            upd_col = st.selectbox("Column to Update", [c for c in required_cols if c != key_col])
            new_value = st.text_input("New Value")
            submit_upd = st.form_submit_button("Update Record")
            if submit_upd:
                upd_key_norm = normalize_string(upd_key)
                new_val_norm = normalize_string(new_value)
                if not upd_key_norm:
                    st.warning("Please provide a key to update.")
                else:
                    escaped_key = str(upd_key_norm).replace("'", "''")
                    # fetch old value for logging
                    try:
                        old_df = session.sql("SELECT " + upd_col + " FROM " + temp_table + " WHERE " + key_col + " = '" + escaped_key + "'").to_pandas()
                        old_val = old_df.iloc[0, 0] if not old_df.empty else None
                    except Exception:
                        old_val = None
                    escaped_new = "" if new_val_norm is None else str(new_val_norm).replace("'", "''")
                    update_sql = "UPDATE " + temp_table + " SET " + upd_col + " = '" + escaped_new + "' WHERE " + key_col + " = '" + escaped_key + "'"
                    session.sql(update_sql).collect()
                    log_change(main_table, "UPDATE", {upd_col: old_val}, {upd_col: new_value})
                    st.success("Record updated in TEMP and logged.")

        # ---------- Delete Record in TEMP ----------
        st.subheader("Delete Record from TEMP Table")
        with st.form(f"delete_{key}"):
            del_key = st.text_input(key_col + " to Delete")
            confirm = st.checkbox("Confirm Delete")
            submit_del = st.form_submit_button("Delete Record")
            if submit_del:
                if not confirm:
                    st.warning("Please confirm delete.")
                else:
                    del_key_norm = normalize_string(del_key)
                    if not del_key_norm:
                        st.warning("Please provide a key to delete.")
                    else:
                        escaped_key = str(del_key_norm).replace("'", "''")
                        try:
                            old_df = session.sql("SELECT * FROM " + temp_table + " WHERE " + key_col + " = '" + escaped_key + "'").to_pandas()
                            old_val = old_df.to_dict(orient="records")[0] if not old_df.empty else None
                        except Exception:
                            old_val = None
                        delete_sql = "DELETE FROM " + temp_table + " WHERE " + key_col + " = '" + escaped_key + "'"
                        session.sql(delete_sql).collect()
                        log_change(main_table, "DELETE", old_val, None)
                        st.success("Record deleted from TEMP and logged.")

# --------------------------------------
# Approval Dashboard (with pending count)
# --------------------------------------
st.markdown("## Approval Dashboard")
try:
    logs = session.sql("SELECT * FROM " + LOG_TABLE + " WHERE approved = FALSE").to_pandas()
except Exception as e:
    st.error(str(e))
    logs = pd.DataFrame()

# show pending count above the editor
total_pending = len(logs)
st.markdown(f"### Pending Records for Approval: **{total_pending}**")

if logs.empty:
    st.success("No pending approvals.")
else:
    logs.columns = [c.lower() for c in logs.columns]
    display_cols = [c for c in logs.columns if c not in ["approved", "approved_by", "approved_at"]]
    display_df = logs[display_cols].copy().reset_index(drop=True)
    if "approve" not in display_df.columns:
        display_df["approve"] = False

    edited_df = st.data_editor(
        display_df,
        use_container_width=True,
        height=400,
        column_config={
            "approve": st.column_config.CheckboxColumn("Approve", help="Approve this record", width=80)
        },
        hide_index=True
    )

    if st.button("Approve Selected Records"):
        to_approve = edited_df[edited_df["approve"] == True]
        if to_approve.empty:
            st.warning("No rows selected for approval.")
        else:
            inserted_count = 0
            for _, row in to_approve.iterrows():
                table_name = row.get("table_name")
                new_val_raw = row.get("new_value")
                # parse new_value safely
                new_val = {}
                try:
                    if isinstance(new_val_raw, dict):
                        new_val = new_val_raw
                    else:
                        s = str(new_val_raw).strip()
                        if s.startswith("$$") and s.endswith("$$"):
                            s = s[2:-2].strip()
                        try:
                            new_val = json.loads(s)
                        except Exception:
                            # try fallback replacements
                            try:
                                new_val = json.loads(s.replace("'", '"'))
                            except Exception:
                                new_val = {}
                except Exception:
                    new_val = {}

                # find main table mapping
                main_table_name = None
                main_info = None
                for k, info in main_tables.items():
                    if info["name"] == table_name:
                        main_table_name = info["name"]
                        main_info = info
                        break
                if main_table_name is None:
                    st.error("No mapping found for table: " + str(table_name))
                    continue

                cols = main_info["required_cols"]
                vals = []
                for c in cols:
                    v = None
                    if isinstance(new_val, dict):
                        # try upper/lower key variants
                        if c in new_val:
                            v = new_val.get(c)
                        elif c.lower() in new_val:
                            v = new_val.get(c.lower())
                        elif c.upper() in new_val:
                            v = new_val.get(c.upper())
                        else:
                            v = None
                    # normalize string if present
                    if isinstance(v, str):
                        v = normalize_string(v)
                    if v is None or v == "":
                        vals.append("NULL")
                    else:
                        vals.append("'" + str(v).replace("'", "''") + "'")
                insert_sql = "INSERT INTO " + main_table_name + " (" + ", ".join(cols) + ") VALUES (" + ", ".join(vals) + ")"
                try:
                    session.sql(insert_sql).collect()
                    # mark log as approved using changed_at + table_name + changed_by to uniquely find it
                    try:
                        changed_at_val = row.get("changed_at")
                        chs = str(changed_at_val)
                        # safe update where clause uses table_name and changed_at textual match (best-effort)
                        upd_sql = (
                            "UPDATE " + LOG_TABLE +
                            " SET approved = TRUE, approved_by = 'business_user', approved_at = CURRENT_TIMESTAMP "
                            "WHERE table_name = '" + str(table_name).replace("'", "''") + "' "
                            "AND changed_at = '" + chs.replace("'", "''") + "'"
                        )
                        session.sql(upd_sql).collect()
                    except Exception:
                        # ignore approval-mark failure (we still inserted)
                        pass
                    inserted_count += 1
                except Exception as e:
                    st.error("Insert failed for table " + str(main_table_name) + ": " + str(e))
                    continue

            st.success("Approved and inserted " + str(inserted_count) + " record(s) into main table.")

            # attempt to rerun/refresh
            try:
                if hasattr(st, "experimental_rerun"):
                    st.experimental_rerun()
                elif hasattr(st, "rerun"):
                    st.rerun()
                else:
                    import streamlit.components.v1 as components
                    components.html("<script>window.location.reload()</script>", height=0)
            except Exception:
                import streamlit.components.v1 as components
                components.html("<script>window.location.reload()</script>", height=0)

# --------------------------------------
# Tabs
# --------------------------------------
tab1, tab2 = st.tabs(["DDM_DOMAIN_VALUE", "DDM_XREF_DOMAIN_VALUE"])
render_table_ui(tab1, "DDM_DOMAIN_VALUE")
render_table_ui(tab2, "DDM_XREF_DOMAIN_VALUE")
